{
  "$defs": {
    "AcceptanceOutputKind": {
      "enum": [
        "article",
        "markdown",
        "metadata"
      ],
      "title": "AcceptanceOutputKind",
      "type": "string"
    },
    "AcquisitionProvenance": {
      "description": "Exact final content-acquisition route alongside the legacy source label.",
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "route": {
          "title": "Route",
          "type": "string"
        },
        "representation": {
          "enum": [
            "metadata",
            "html",
            "xml",
            "pdf"
          ],
          "title": "Representation",
          "type": "string"
        },
        "transport": {
          "enum": [
            "api",
            "browser",
            "http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "route",
        "representation",
        "transport"
      ],
      "title": "AcquisitionProvenance",
      "type": "object"
    },
    "ArtifactVerificationStatus": {
      "description": "File state observed while the immutable record was built.",
      "enum": [
        "verified",
        "missing",
        "unreadable"
      ],
      "title": "ArtifactVerificationStatus",
      "type": "string"
    },
    "AssetAcceptanceFacet": {
      "properties": {
        "requested": {
          "title": "Requested",
          "type": "boolean"
        },
        "profile": {
          "default": "unknown",
          "enum": [
            "none",
            "body",
            "all",
            "unknown"
          ],
          "title": "Profile",
          "type": "string"
        },
        "audited": {
          "default": false,
          "title": "Audited",
          "type": "boolean"
        },
        "expected": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "discovered": {
          "default": 0,
          "minimum": 0,
          "title": "Discovered",
          "type": "integer"
        },
        "attempted": {
          "default": 0,
          "minimum": 0,
          "title": "Attempted",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "local": {
          "default": 0,
          "minimum": 0,
          "title": "Local",
          "type": "integer"
        },
        "full_size": {
          "default": 0,
          "minimum": 0,
          "title": "Full Size",
          "type": "integer"
        },
        "preview": {
          "default": 0,
          "minimum": 0,
          "title": "Preview",
          "type": "integer"
        },
        "accepted_preview": {
          "default": 0,
          "minimum": 0,
          "title": "Accepted Preview",
          "type": "integer"
        },
        "fallback_preview": {
          "default": 0,
          "minimum": 0,
          "title": "Fallback Preview",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "placeholder_suspected": {
          "default": 0,
          "minimum": 0,
          "title": "Placeholder Suspected",
          "type": "integer"
        },
        "not_archived": {
          "default": 0,
          "minimum": 0,
          "title": "Not Archived",
          "type": "integer"
        },
        "remote_link_count": {
          "default": 0,
          "minimum": 0,
          "title": "Remote Link Count",
          "type": "integer"
        },
        "remote_only_count": {
          "default": 0,
          "minimum": 0,
          "title": "Remote Only Count",
          "type": "integer"
        },
        "failure_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Failure Codes",
          "type": "array"
        },
        "issue_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Issue Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AssetAcceptanceStatus"
        },
        "remote_links_preserved": {
          "title": "Remote Links Preserved",
          "type": "boolean"
        }
      },
      "required": [
        "requested",
        "status",
        "remote_links_preserved"
      ],
      "title": "AssetAcceptanceFacet",
      "type": "object"
    },
    "AssetAcceptanceStatus": {
      "enum": [
        "complete",
        "degraded",
        "failed",
        "unavailable",
        "unknown",
        "not_applicable",
        "not_requested"
      ],
      "title": "AssetAcceptanceStatus",
      "type": "string"
    },
    "ContentAcceptanceFacet": {
      "properties": {
        "status": {
          "$ref": "#/$defs/ContentAcceptanceStatus"
        },
        "has_fulltext": {
          "title": "Has Fulltext",
          "type": "boolean"
        },
        "has_abstract": {
          "title": "Has Abstract",
          "type": "boolean"
        },
        "token_estimate": {
          "default": 0,
          "minimum": 0,
          "title": "Token Estimate",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "tables": {
          "$ref": "#/$defs/TableAcceptanceFacet"
        },
        "formulas": {
          "$ref": "#/$defs/FormulaAcceptanceFacet"
        }
      },
      "required": [
        "status",
        "has_fulltext",
        "has_abstract"
      ],
      "title": "ContentAcceptanceFacet",
      "type": "object"
    },
    "ContentAcceptanceStatus": {
      "enum": [
        "fulltext",
        "abstract_only",
        "metadata_only",
        "unavailable"
      ],
      "title": "ContentAcceptanceStatus",
      "type": "string"
    },
    "FetchAcceptanceFacet": {
      "properties": {
        "status": {
          "$ref": "#/$defs/FetchAcceptanceStatus"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        }
      },
      "required": [
        "status",
        "completed"
      ],
      "title": "FetchAcceptanceFacet",
      "type": "object"
    },
    "FetchAcceptanceReport": {
      "description": "Canonical acceptance report shared by all external adapters.",
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "minimum_reader_schema_version": {
          "const": 2,
          "title": "Minimum Reader Schema Version",
          "type": "integer"
        },
        "overall": {
          "$ref": "#/$defs/OverallAcceptanceStatus"
        },
        "identity": {
          "$ref": "#/$defs/IdentityAcceptanceFacet"
        },
        "fetch": {
          "$ref": "#/$defs/FetchAcceptanceFacet"
        },
        "content": {
          "$ref": "#/$defs/ContentAcceptanceFacet"
        },
        "asset": {
          "$ref": "#/$defs/AssetAcceptanceFacet"
        },
        "output": {
          "$ref": "#/$defs/OutputAcceptanceFacet"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceAcceptanceFacet"
        }
      },
      "required": [
        "schema_version",
        "minimum_reader_schema_version",
        "overall",
        "identity",
        "fetch",
        "content",
        "asset",
        "output",
        "provenance"
      ],
      "title": "FetchAcceptanceReport",
      "type": "object"
    },
    "FetchAcceptanceStatus": {
      "enum": [
        "ok",
        "failed",
        "action_required"
      ],
      "title": "FetchAcceptanceStatus",
      "type": "string"
    },
    "FormulaAcceptanceFacet": {
      "properties": {
        "fallback_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fallback Count",
          "type": "integer"
        },
        "missing_count": {
          "default": 0,
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        }
      },
      "title": "FormulaAcceptanceFacet",
      "type": "object"
    },
    "IdentityAcceptanceFacet": {
      "properties": {
        "status": {
          "$ref": "#/$defs/IdentityAcceptanceStatus"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "expected_doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "candidate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "canonical_landing_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Landing Url"
        },
        "canonical_landing_verified": {
          "default": false,
          "title": "Canonical Landing Verified",
          "type": "boolean"
        },
        "canonical_landing_unique": {
          "default": false,
          "title": "Canonical Landing Unique",
          "type": "boolean"
        },
        "codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Codes",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "IdentityAcceptanceFacet",
      "type": "object"
    },
    "IdentityAcceptanceStatus": {
      "enum": [
        "resolved",
        "ambiguous",
        "mismatch",
        "unavailable"
      ],
      "title": "IdentityAcceptanceStatus",
      "type": "string"
    },
    "JsonValue": {},
    "LegacyArtifactField": {
      "description": "Legacy CLI field supplied by one output artifact.",
      "enum": [
        "output_path",
        "saved_markdown_path"
      ],
      "title": "LegacyArtifactField",
      "type": "string"
    },
    "ManifestError": {
      "additionalProperties": true,
      "description": "Structured failure with transport-specific additive facts preserved.",
      "properties": {
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "ManifestError",
      "type": "object"
    },
    "ManifestOutputArtifact": {
      "description": "Immutable file facts observed at record completion.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "legacy_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegacyArtifactField"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "mtime": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtime"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "verification_status": {
          "$ref": "#/$defs/ArtifactVerificationStatus"
        }
      },
      "required": [
        "path",
        "kind",
        "completed_at",
        "verification_status"
      ],
      "title": "ManifestOutputArtifact",
      "type": "object"
    },
    "ManifestRecordStatus": {
      "description": "Lifecycle of one immutable attempt record.",
      "enum": [
        "completed",
        "failed",
        "aborted"
      ],
      "title": "ManifestRecordStatus",
      "type": "string"
    },
    "ManifestRequest": {
      "description": "Original query plus JSON request semantics covered by the fingerprint.",
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "query"
      ],
      "title": "ManifestRequest",
      "type": "object"
    },
    "ManifestSemanticLosses": {
      "description": "Stable compatibility summary derived from acceptance content facets.",
      "properties": {
        "table_fallback_count": {
          "default": 0,
          "minimum": 0,
          "title": "Table Fallback Count",
          "type": "integer"
        },
        "table_layout_degraded_count": {
          "default": 0,
          "minimum": 0,
          "title": "Table Layout Degraded Count",
          "type": "integer"
        },
        "table_semantic_loss_count": {
          "default": 0,
          "minimum": 0,
          "title": "Table Semantic Loss Count",
          "type": "integer"
        },
        "table_legacy_lossy_count": {
          "default": 0,
          "minimum": 0,
          "title": "Table Legacy Lossy Count",
          "type": "integer"
        },
        "formula_fallback_count": {
          "default": 0,
          "minimum": 0,
          "title": "Formula Fallback Count",
          "type": "integer"
        },
        "formula_missing_count": {
          "default": 0,
          "minimum": 0,
          "title": "Formula Missing Count",
          "type": "integer"
        }
      },
      "title": "ManifestSemanticLosses",
      "type": "object"
    },
    "ManifestTraceEvent": {
      "description": "Pydantic wire representation of the canonical TraceEvent.",
      "properties": {
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "outcome": {
          "default": "info",
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "attempt": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "error_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Category"
        },
        "retryable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retryable"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "target_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Sha256"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        }
      },
      "required": [
        "stage",
        "component"
      ],
      "title": "ManifestTraceEvent",
      "type": "object"
    },
    "OutputAcceptanceFacet": {
      "properties": {
        "status": {
          "$ref": "#/$defs/OutputAcceptanceStatus"
        },
        "requested": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcceptanceOutputKind"
          },
          "title": "Requested",
          "type": "array"
        },
        "available": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcceptanceOutputKind"
          },
          "title": "Available",
          "type": "array"
        },
        "missing": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcceptanceOutputKind"
          },
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "OutputAcceptanceFacet",
      "type": "object"
    },
    "OutputAcceptanceStatus": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "not_requested"
      ],
      "title": "OutputAcceptanceStatus",
      "type": "string"
    },
    "OverallAcceptanceStatus": {
      "description": "Stable top-level acceptance outcomes.",
      "enum": [
        "complete",
        "degraded",
        "limited",
        "failed",
        "action_required"
      ],
      "title": "OverallAcceptanceStatus",
      "type": "string"
    },
    "ProvenanceAcceptanceFacet": {
      "properties": {
        "status": {
          "$ref": "#/$defs/ProvenanceAcceptanceStatus"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcquisitionProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trace_event_count": {
          "default": 0,
          "minimum": 0,
          "title": "Trace Event Count",
          "type": "integer"
        },
        "fallback_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallback Codes",
          "type": "array"
        },
        "warning_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warning Codes",
          "type": "array"
        },
        "failure_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Failure Codes",
          "type": "array"
        },
        "unstructured_warning_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unstructured Warning Count",
          "type": "integer"
        },
        "acceptance_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Policy"
        },
        "acceptance_policy_satisfied": {
          "default": false,
          "title": "Acceptance Policy Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "status"
      ],
      "title": "ProvenanceAcceptanceFacet",
      "type": "object"
    },
    "ProvenanceAcceptanceStatus": {
      "enum": [
        "complete",
        "partial",
        "missing"
      ],
      "title": "ProvenanceAcceptanceStatus",
      "type": "string"
    },
    "TableAcceptanceFacet": {
      "properties": {
        "fallback_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fallback Count",
          "type": "integer"
        },
        "layout_degraded_count": {
          "default": 0,
          "minimum": 0,
          "title": "Layout Degraded Count",
