# Paper Fetch Skill configuration
#
# Copy this file to ~/.config/paper-fetch/.env, or keep it elsewhere and set
# PAPER_FETCH_ENV_FILE=/path/to/.env. A repo-local .env is not auto-loaded.
# Blank values are treated as "not configured". Process environment variables
# override values loaded from env files.

# Leave unset to use paper_fetch.config.DEFAULT_USER_AGENT.
# PAPER_FETCH_SKILL_USER_AGENT=""

# Runtime paths
# PAPER_FETCH_DOWNLOAD_DIR=""
# XDG_DATA_HOME=""

# Formula conversion
# Default runtime behavior prefers texmath and falls back to mathml-to-latex.
# Uncomment to force a specific backend:
# PAPER_FETCH_FORMULA_TOOLS_DIR=""
# MATHML_CONVERTER_BACKEND="texmath"
# TEXMATH_BIN=""
# MATHML_TO_LATEX_NODE_BIN="node"
# MATHML_TO_LATEX_SCRIPT=""
#
# Advanced mml2tex backend overrides. The default installer does not prepare
# these assets; set MATHML_CONVERTER_BACKEND="mml2tex" only when you provide
# the Java/XSLT toolchain yourself.
# MML2TEX_JAVA_BIN=""
# MML2TEX_CLASSPATH=""
# MML2TEX_SAXON_JAR=""
# MML2TEX_XMLRESOLVER_JAR=""
# MML2TEX_XMLRESOLVER_DATA_JAR=""
# MML2TEX_STYLESHEET=""
# MML2TEX_CATALOG=""

# Recommended for Crossref polite pool and contactability
CROSSREF_MAILTO=""

# Elsevier official APIs only; optional for ScienceDirect browser HTML/PDF
ELSEVIER_API_KEY=""

# Wiley official TDM PDF lane
WILEY_TDM_CLIENT_TOKEN=""

# All 13 browser publishers use Byparr + managed Camoufox on supported platforms.
# auto, camoufox (compatibility alias), and byparr select the combined runtime.
# Original native/JSON state directories stay bound to their configuration.
# CLI browser paths default to on-demand managed runtime preparation; MCP/library
# paths default off. Set false to forbid it globally or true to opt in globally.
# PAPER_FETCH_BROWSER_AUTO_PREPARE="false"
# PAPER_FETCH_PNAS_BROWSER_BACKEND="auto"
# PAPER_FETCH_ELSEVIER_BROWSER_BACKEND="auto"
# PAPER_FETCH_BROWSER_COMPONENT_CACHE="/path/to/shared/byparr-components"
# PAPER_FETCH_<PROVIDER>_BROWSER_BACKEND accepts only that provider's declared backends.
# Preparation is lazy. Successful online checks are reused for 24 hours; failures may retry.
# PAPER_FETCH_BROWSER_HEADLESS="true"
# PAPER_FETCH_BROWSER_BINARY_PATH=""
# PAPER_FETCH_BROWSER_PROFILE_DIR=""
# PAPER_FETCH_BROWSER_USER_DATA_DIR=""
# PAPER_FETCH_BROWSER_TIMEOUT_MS="120000"
# PAPER_FETCH_BROWSER_USER_AGENT=""
