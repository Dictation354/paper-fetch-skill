* text=auto

# POSIX entrypoints must stay LF-only after Windows checkouts.
*.sh text eol=lf

# Source, contracts, workflows, and documentation are cross-platform text.
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Golden corpus PDFs are immutable binary replay inputs.
*.pdf binary
*.dll binary

# Preserve the byte-for-byte upstream release license covered by its pin.
installer/vendor/uninsis/LICENSE binary

# Native Windows launchers use Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Captured source bytes (including publisher whitespace) are hash-verified.
tests/fixtures/**/*.html -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tests/fixtures/**/*.xml -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tests/fixtures/**/acquisition/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Historical test output retains the original warning whitespace and line endings.
docs/test-layer-results/*.log -text whitespace=-blank-at-eol,-blank-at-eof
