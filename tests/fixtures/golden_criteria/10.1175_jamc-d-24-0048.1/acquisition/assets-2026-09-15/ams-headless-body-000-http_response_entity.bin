<div id="fig6" class="figure"><figure><div class="figure-body flex flex-col flex@md-row"><div style="max-width: 450px;" class="figure-image-wrapper w-1 my-auto"><div style="max-width: 450px;" class="image-wrapper flex flex-col flex-align-start"><img data-image-src="/view/journals/apme/63/12/inline-JAMC-D-24-0048.1-f6.jpg" src="/skin/710ad8a6b2413221890b4b07720ada0d29d8e951/img/Blank.svg" class="lazy-load" style="max-width: 450px;" alt="Fig. 6."/><div id="" role="" class="position-absolute display-none" data-popover="8b50e0ed-5a31-4b6f-bd2f-1066a7a24b92-2c49685c-a2ff-4fcf-af91-d4af10e53c9f" data-popover-breakpoints="" data-popover-placement="" data-popover-fullscreen="true">
				
	        <div style="top: 0; left: 0; width: calc(100vw - 40px); height: calc(100vh - 40px);" class="c-Paper c-Paper--elevation-3 display-flex flex-col flex@xs-row pt-2 pr-2 pb-2 pl-2 overflow-scroll" role="" id="">
	        	
