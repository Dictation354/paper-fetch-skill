[{"award-number":["1ZIADE000380"]}],"id":[{"id":"10.13039\/501100022770","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100007155","name":"Medical Research Council Canada","doi-asserted-by":"publisher","award":["MR\/Z506011\/1"],"award-info":[{"award-number":["MR\/Z506011\/1"]}],"id":[{"id":"10.13039\/501100007155","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100007155","name":"Medical Research Council Canada","doi-asserted-by":"publisher","award":["MR\/Y014537\/1"],"award-info":[{"award-number":["MR\/Y014537\/1"]}],"id":[{"id":"10.13039\/501100007155","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100010269","name":"Wellcome","doi-asserted-by":"publisher","award":["203151\/A\/16\/Z"],"award-info":[{"award-number":["203151\/A\/16\/Z"]}],"id":[{"id":"10.13039\/100010269","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100010269","name":"Wellcome","doi-asserted-by":"publisher","award":["226795\/Z\/22\/Z"],"award-info":[{"award-number":["226795\/Z\/22\/Z"]}],"id":[{"id":"10.13039\/100010269","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100000265","name":"Medical Research Council","doi-asserted-by":"publisher","award":["MC_PC_17230"],"award-info":[{"award-number":["MC_PC_17230"]}],"id":[{"id":"10.13039\/501100000265","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100010663","name":"H2020 European Research Council","doi-asserted-by":"publisher","award":["772798"],"award-info":[{"award-number":["772798"]}],"id":[{"id":"10.13039\/100010663","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":["www.science.org"],"crossmark-restriction":true},"short-container-title":["Science"],"published-print":{"date-parts":[[2026,4,9]]},"abstract":"<jats:p>Tissue regeneration is rare in mammals, but the digit tip can regrow after amputation, whereas injuries beyond the nail do not. How the microenvironment drives divergent outcomes remains unclear. In this study, we found that the extracellular matrix (ECM) and tissue mechanics govern the amputation response in mouse digits. Nonregenerative regions were stiffer and contained dense, organized collagen, whereas regenerative regions were soft and enriched in hyaluronic acid (HA). Depleting HA inhibited regeneration and promoted fibrosis, demonstrating that the HA-collagen balance shaped tissue mechanics and repair signaling. Stabilization of HA with hyaluronan and proteoglycan link protein 1 (HAPLN1) after nonregenerative amputations tuned ECM mechanics, reduced scarring, and enhanced bone repair. Thus, ECM composition and mechanics influence cell behavior and ECM-targeted strategies could help unlock mammalian regeneration.<\/jats:p>","DOI":"10.1126\/science.ady3136","type":"journal-article","created":{"date-parts":[[2026,4,9]],"date-time":"2026-04-09T18:02:54Z","timestamp":1775757774000},"update-policy":"https:\/\/doi.org\/10.34133\/aaas_crossmark","source":"Crossref","is-referenced-by-count":9,"title":["Hyaluronic acid and tissue mechanics orchestrate mammalian digit tip regeneration"],"prefix":"10.1126","volume":"392","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-5903-469X","authenticated-orcid":true,"given":"Byron W. H.","family":"Mui","sequence":"first","affiliation":[{"name":"Cambridge Stem Cell Institute, University of Cambridge, Cambridge, UK."},{"name":"Skeletal Biology Section, National Institute of Dental and Craniofacial Research, National Institutes of Health, Department of Health and Human Services, Bethesda, MD, USA."},{"name":"NIH Oxford-Cambridge Scholars Program, National Institutes of Health, Department of Health and Human Services, Bethesda, MD, USA."},{"name":"Stanford Cardiovascular Institute, Stanford University School of Medicine, Stanford, CA, USA."}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0487-6056","authenticated-orcid":true,"given":"Joseph J. Y.","family":"Wong","sequence":"additional","af