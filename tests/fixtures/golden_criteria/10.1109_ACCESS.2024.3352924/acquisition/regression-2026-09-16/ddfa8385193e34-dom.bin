ab"><a _ngcontent-ng-c1892098097="" class="document-tab-link" href="/document/10388355/metrics">Metrics</a></div><div _ngcontent-ng-c1892098097="" routerlinkactive="active" class="browse-pub-tab similar"><a _ngcontent-ng-c1892098097="" class="document-tab-link" href="/document/10388355/similar">More Like This</a></div><!----></div></nav></div></div><!----></div><div _ngcontent-ng-c1892098097="" class="document-main-content-container col-19-24"><xpl-left-side-bar _ngcontent-ng-c1892098097="" _nghost-ng-c33609792=""><div _ngcontent-ng-c33609792="" xplscrollsnapmigr="" scrollreset="true" offsetfrom="100" fromelementid="mobile-tab-pane" tillelementid="full-text-footer" offsetto="-800" cssclasstostick="document-mobile-leftrail-stick" class="col-2 col-actions ng-col-actions hide-desktop stats-document-container-lh u-printing-invisible-ie u-printing-invisible-ff col-actions-mobile-closed ng-col-actions-mobile-closed"><div _ngcontent-ng-c33609792="" id="left-rail-container"><div _ngcontent-ng-c33609792="" class="doc-actions-mobile-expand-button"></div><!----><ul _ngcontent-ng-c33609792="" class="doc-actions stats-document-lh-actions"><li _ngcontent-ng-c33609792="" class="doc-actions-item py-3"><xpl-view-pdf _ngcontent-ng-c33609792="" placement="document-page-mobile" _nghost-ng-c370763073=""><div _ngcontent-ng-c370763073=""><!----><!----><div _ngcontent-ng-c370763073=""><!----><a _ngcontent-ng-c370763073="" target="_blank" class="doc-actions-link stats-document-lh-action-downloadPdf_2 pdf" href="/stamp/stamp.jsp?tp=&amp;arnumber=10388355"><i _ngcontent-ng-c370763073="" class="icon-size-md icon xpl-pdf-icon fas fa-file-pdf"></i> Download PDF </a><!----><!----></div><!----></div><!----><!----></xpl-view-pdf><!----><xpl-login-modal-trigger _ngcontent-ng-c33609792="" _nghost-ng-c392920450=""><!----><!----></xpl-login-modal-trigger><!----><!----><!----></li><!----><li _ngcontent-ng-c33609792="" class="doc-actions-item py-3"><a _ngcontent-ng-c33609792="" data-analytics_identifier=