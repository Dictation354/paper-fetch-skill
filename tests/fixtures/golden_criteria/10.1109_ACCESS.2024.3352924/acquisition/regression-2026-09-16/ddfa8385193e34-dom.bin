alloy("getIdentity").then(function(result) {
  var ecid = result && result.identity && result.identity.ECID;

  // Guard: ensure ECID exists and is not empty
  if (typeof ecid === "string" && ecid.trim() !== "") {
    var attrs = "; path=/; domain=" + document.location.hostname + "; Secure; SameSite=Lax";

    //document.cookie = "AMCV_8E929CC25A1FB2B30A495C97%40AdobeOrg=1%7CMCMID%7C" + ecid + "%7C" + attrs;
    document.cookie = "Adobe_ECID=" + ecid + attrs;
  }
});
</script><script>
/*
  Logic:
    Initial, first time visit -
      current_delay doesn't exist - previous_delay set to "Not Set"
      page loads - current_delay is set to:
        1. Data Layer exists - "On Load"
        2. Data Layer does not exist but path is in active list - "On Active Paths"
        3. Data Layer does not exist and path is not in active list - "##" seconds either of when DataLayer was created or time out of 10sec
      Data Layer event is present for scenarios 1 & 2 - preloaders rule executes - v67 is pushed as "Not Set"
    OR
      Data Layer is not present, preloaders does not execute.
    Next page loads -
      current_delay exists as set by previous page
      page loads - current_delay is set to:
        1. Data Layer exists - "On Load"
        2. Data Layer does not exist but path is in active list - "On Active Paths"
        3. Data Layer does not exist and path is not in active list - "##" seconds either of when DataLayer was created or time out of 10sec
      Data Layer event is present for scenarios 1 & 2 - preloaders rule executes - v67 is pushed as value set by scenario
    OR
      Data Layer is not present, preloaders does not execute.*

*/

//    console.log("「ΛuΞΤ」: data layer check");
localStorage.setItem("analytics_previous_delay", localStorage.getItem("analytics_current_delay") || "Not Set");
localStorage.setItem("analytics_previous_url", localStorage.getItem("analytics_current_url") || "Not Set");
localStorage.setItem("analytics_current_url",location.href);

//    eVar 67 - to capture the interval delay before getting stopped - on previous page

window.adobeDataLayer = window.adobeDataLayer || [];

if ( adobeDataLayer.length == 0 ){
  var active_paths = {
        "_search_advanced":{
          sheet_name: "Advanced Search",
          sheet_type: "Search"
        },
        "_search_ai":{
          sheet_name: "Xplore AI Home",
          sheet_type: "Search"                
        },
        "_xpl_accessinfo":{
          sheet_name: "What Can I Access",
          sheet_type: "Settings"          
        }
      },
      path = location.pathname.replace(/\//g,"_"),
      payload = JSON.parse(localStorage.getItem("analytics_pageload")) || {event:"view",data:{user_type:"not_loaded"}};

  if ( active_paths[path] ){
      payload.data.sheet_name = active_paths[path].sheet_name;
      payload.data.sheet_type = active_paths[path].sheet_type;
      payload.extension_identifier = "Global:: Top Loaders";
    
    if (payload.data.sheet_name == "Xplore AI Home" ) {
      console.log('「ΛuΞΤ」: data layer check: payload.data.sheet_name == "Xplore AI Home"');
      var waitfordevpush = setTimeout(function(){
        
        var last_push = window.adobeDataLayer.reverse()[0],
            last_sheet = last_push && (last_push.data ? last_push.data.sheet_name:last_push.page.name ) || "";
        
      console.log('「ΛuΞΤ」: data layer check: inTimeout: last_sheet = ' + last_sheet);

        if ( last_sheet != "Research Navigator AI Search" && !(/search\/ai\?searchType=/).test(document.location.href) ) {
          payload = JSON.parse(localStorage.getItem("analytics_pageload"));
          payload.data.sheet_name = "Research Navigator AI Search";
          payload.data.sheet_type = "Search";
          payload.extension_identifier = "Global:: Top Loaders: patch";
          payload.debug = {page_name:"Set from active_paths logic"}
          adobeDataLayer.push(payload);
      console.log('「ΛuΞΤ」: data layer check: inTimeout: push payload');
        }
        clearTimeout(waitfordevpush);
      },3000);
      
    } else {
      adobeDataLayer.push(payload);
    }
    
      localStorage.setItem("analytics_current_delay", "On Active Paths");

  } else {
    let count = 0,
        delay = 500;

    const intervalId = setInterval(() => {
      count++;
//      console.log(`「ΛuΞΤ」: data layer check: Interval Count: ${count}`);
      if (adobeDataLayer.length > 0 || count === 20) {
        localStorage.setItem("analytics_current_delay", (count * delay)/1000 );
        clearInterval(intervalId);
//        console.log("「ΛuΞΤ」: data layer check: Interval Stopped: " + count);
      }
    }, delay);
  }
} else {
//      console.log("「ΛuΞΤ」: data layer check: Loaded on 1st attempt");
  localStorage.setItem("analytics_current_delay", "On Load");
}
</script><script type="osano/blocked" async=""></script><div style="position: absolute; width: 0px; height: 0px; overflow: hidden; padding: 0px; border: 0px; margin: 0px;"><div id="MathJax_Font_Test" style="position: absolute; visibility: hidden; top: 0px; left: 0px; width: auto; min-width: 0px; max-width: none; padding: 0px; border: 0px; margin: 0px; white-space: nowrap; text-align: left; text-indent: 0px; text-transform: none; line-height: normal; letter-spacing: normal; word-spacing: normal; font-size: 40px; font-weight: normal; font-style: normal; font-size-adjust: none; font-family: MathJax_Main, sans-serif;"></div></div></body></html>