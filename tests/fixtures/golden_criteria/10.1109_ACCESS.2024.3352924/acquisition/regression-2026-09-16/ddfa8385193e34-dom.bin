	xplGlobal.document.metadata={"userInfo":{"customerNameRaw":"Peking University","institutionName":"Peking University","authType":["ipv6"],"institute":true,"member":false,"individual":false,"guest":false,"subscribedContent":false,"fileCabinetContent":false,"fileCabinetUser":false,"dtrDeleteCookieOnLogout":false,"institutionalFileCabinetUser":false,"products":"EBOOKS:1872:2020|MITP:1943:2020|WILEYTELECOM:2005:2020|NOW:2004:2018|IBM:1872:2020|MCSYNTH3|MCSYNTH4|MCSYNTH7|MCSYNTH1|MCSYNTH2|MCSYNTH5|MCSYNTH6|MCSYNTH9|MCSYNTH8|MITP_DISCONTINUED|IEL|VDE|NOKIA BELL LABS|","instType":"Academic","userIds":[7863],"dtrCookieExpirationDays":90,"showPatentCitations":true,"showGet802Link":true,"openUrlImgLoc":"/assets/img/btn.find-in-library.png","openUrlLink":"http://zm8lp2fe5j.search.serialssolutions.com/","showOpenUrlLink":true,"tracked":false,"ringGoldId":"12465","institutionUserId":7863,"delegatedAdmin":false,"desktop":false,"isInstitutionDashboardEnabled":false,"isInstitutionProfileEnabled":false,"isRoamingEnabled":true,"isDelegatedAdmin":false,"isMdl":false,"isCwg":false,"isIel":true,"isAcademic":true,"isReadAndPublish":false},"authors":[{"name":"João Vieira","affiliation":["Instituto de Engenharia de Sistemas e Computadores-Investigação e Desenvolvimento (INESC-ID), Instituto Superior Técnico, University of Lisbon, Lisbon, Portugal"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10380310/10388355/vieir-3352924-small.gif","p":["João Vieira (Member, IEEE) received the M.Sc. degree in electrical and computer engineering from the Instituto Superior Técnico, Lisbon, Portugal, in 2018, where he is currently pursuing the Ph.D. degree. He was a Research Intern with the Processor Architecture Laboratory, Swiss Federal Institute of Technology Lausanne, Switzerland, in 2018, and the Laboratory for NanoIntegrated Systems, University of Utah, USA, in 2019. He is a Research Assistant with the High-Performance Computing Architectures and Systems Research Group, Instituto de Engenharia de Sistemas e Computadores-Investigação e Desenvolvimento (INESC-ID), University of Lisbon, Lisbon. His research interests include high-performance computing architectures, near-data processing, and hardware/software co- design."]},"firstName":"João","lastName":"Vieira","orcid":"0000-0003-0038-2830","id":"37089733114"},{"name":"Nuno Roma","affiliation":["Instituto de Engenharia de Sistemas e Computadores-Investigação e Desenvolvimento (INESC-ID), Instituto Superior Técnico, University of Lisbon, Lisbon, Portugal"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10380310/10388355/roma-3352924-small.gif","p":["Nuno Roma (Senior Member, IEEE) received the Ph.D. degree in electrical and computer engineering from the Instituto Superior Técnico (IST), University of Lisbon, Lisbon, Portugal, in 2008. He is currently an Associate Professor with the Department of Electrical and Computer Engineering, IST, and a Senior Researcher with the Instituto de Engenharia de Sistemas e Computadores-Investigação e Desenvolvimento (INESC-ID), University of Lisbon. He has a consolidated experience in funded research project leadership. He contributed to more than 130 manuscripts in journals and international conferences. His research interests include computer architectures, specialized and dedicated structures for digital signal processing, energy-aware computing, parallel processing, and high-performance computing systems. He is a Senior Member of ACM and the HiPEAC-Network of Excellence. He served as a Guest Editor for IEEE Design and Test, Journal of Real-Time Image Processing (Springer), and EURASIP Journal on Embedded Systems (JES)."]},"firstName":"Nuno","lastName":"Roma","orcid":"0000-0003-2491-4977","id":"37331027900"},{"name":"Gabriel Falcao","affiliation":["Instituto de Telecomunicações, University of Coimbra, Coimbra, Portugal"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10380310/10388355/falca-3352924-small.gif","p":["Gabriel Falcao (Senior Member, IEEE) received the Ph.D. degree from the University of Coimbra, in 2010. From 2011 to 2012 and from 2017 to 2018, he was a Visiting Professor with EPFL. In the Summer of 2018, he was a Visiting Academic with ETHZ, Switzerland. He is currently an Assistant Professor with the Department of Electrical and Computer Engineering, University of Coimbra, and a Researcher with the Instituto de Telecomunicações. His research interests include parallel computer architectures, energy-efficient processing, compute-intensive signal processing applications, and compute-intensive signal processing applications. He is a member of the IEEE Signal Processing Society and a Full Member of the HiPEAC-Network of Excellence. He was the General Co-Chair of IEEE SiPS 2021. He serves as an Associate Editor for IEEE Micro magazine and IEEE Transactions on Signal Processing."]},"firstName":"Gabriel","lastName":"Falcao","orcid":"0000-0001-9805-6747","id":"37394052900"},{"name":"Pedro Tomás","affiliation":["Instituto de Engenharia de Sistemas e Computadores-Investigação e Desenvolvimento (INESC-ID), Instituto Superior Técnico, University of Lisbon, Lisbon, Portugal"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10380310/10388355/tomas-3352924-small.gif","p":["Pedro Tomás (Senior Member, IEEE) received the Ph.D. degree in electrical and computer engineering (ECE) from the Instituto Superior Técnico (IST), University of Lisbon, Portugal, in 2009. He is currently an Associate Professor with the Department of Electronics and Communication Engineering (ECE), IST, and a Senior Researcher with the Instituto de Engenharia de Sistemas e Computadores-Investigação e Desenvolvimento (INESC-ID), University of Lisbon. He has contributed more than 80 papers to international peer-reviewed journals and conferences. His research interests include computer microarchitectures, specialized computational structures, and high-performance computing. He is also interested in artificial intelligence models and algorithms. He is a member of the IEEE Computer Society."]},"firstName":"Pedro","lastName":"Tomás","orcid":"0000-0001-8083-4432","id":"37564017900"}],"issn":[{"format":"Electronic ISSN","value":"2169-3536"}],"articleNumber":"10388355","mediaPath":"/mediastore/IEEE/content/media/6287639/10380310/10388355","dbTime":"4 ms","metrics":{"wosCitationCount":0,"citationCountPaper":5,"citationCountPatent":0,"totalDownloads":1667},"purchaseOptions":{"showOtherFormatPricingTab":false,"showPdfFormatPricingTab":true,"pdfPricingInfoAvailable":false,"otherPricingInfoAvailable":false,"mandatoryBundle":false,"optionalBundle":false,"displayTextWhenPdfPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information.","displayTextWhenOtherFormatPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information.","openUrlFullLink":"http://zm8lp2fe5j.search.serialssolutions.com/?url_ver=Z39.88-2004&rfr_id=info:sid/IEEE.org:XPLORE&rft_id=info:doi/10.1109/ACCESS.2024.3352924&url_ctx_fmt=info:ofi/fmt:kev:mtx:ctx&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.atitle=NDPmulator Enabling Full-System Simulation for Near-Data Accelerators From Caches to DRAM&rft.jtitle=IEEE Access&rft.date=2024&rft.volume=12&rft.spage=10349&rft.epage=10365&rft.eissn=2169-3536&rft.au=João Vieira&rft.aulast=João Vieira"},"getProgramTermsAccepted":false,"sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"graphicalAbstract":{"summary":"Physical representation of the proposed NDPmulator. BW2* and BW3* represent configurable parameters that define the bandwidths between the different levels of the memory hierarchy and the Near-Data Accelerator. The L1I and L1D blocks represent L1 instruction and data caches, respectively, while the L2/LLC block represents the L2 unified cache, which corresponds to the Last-Level Cache of the depicted system.","type":"graphic","fileSize":"98KB","file":"/ielx7/6287639/10380310/10388355/graphical_abstract/access-gagraphic-3352924.jpg","coverImage":"/ielx7/6287639/10380310/10388355/graphical_abstract/access-gagraphic-3352924.jpg"},"abstract":"The accurate simulation and performance assessment of Near-Data Accelerators (NDAccs) is a complex challenge as it must consider the operation of the entire processing system, the impact of the Operating System (OS) overheads, and the memory contention caused by concurrent processes. While recent proposals have attempted to repurpose and extend existing tools, the offered support for the development and evaluation of NDAccs is limited and full-system simulation is rarely provided. To mitigate this problem, the NDPmulator simulation framework, based on the widely established gem5 architectural simulator, is herein proposed. NDPmulator provides System Emulation (SE) and Full System (FS) support for the development and evaluation of novel NDAccs deployed at multiple levels of the memory hierarchy. To demonstrate its versatility and performance-efficiency, the proposed NDPmulator is used to model three existing NDAccs, showing that it can accurately estimate and anticipate the results of the evaluation performed by the original authors while requiring a significantly smaller implementation effort and a fraction of the simulation time. Furthermore, NDPmulator offers the possibility to conduct complex experiments where the NDAcc is coupled to a real system featuring an OS. Hence it allows modeling all overheads related to the NDAcc device driver, the OS, and the contention caused by concurrent and background processes.","publicationDate":"2024","publicationYear":"2024","pdfPath":"/iel7/6287639/10380310/10388355.pdf","publicationTitle":"IEEE Access","pdfUrl":"/stamp/stamp.jsp?tp=&arnumber=10388355","startPage":"10349","endPage":"10365","displayPublicationTitle":"IEEE Access","keywords":[{"type":"IEEE Keywords","kwd":["Random access memory","Micromechanical devices","Memory management","Reduced instruction set computing","Kernel","Registers","Programming"]},{"type":"Index Terms","kwd":["Processing System","Characteristics Of System","Levels Of Hierarchy","Fraction Of Time","Memory Hierarchy","Benchmark","Convolutional Neural Network","Memory Processes","Direct Access","Single Application","Random Access Memory","Memory Devices","Usage In Applications","Instruction Set Architecture","Security Mechanisms","Hardware Accelerators","Resistive Random Access Memory","Data Cache","Physical Address","Static Random Access Memory","Virtual Memory","L2 Cache","Increase In Execution Time","Physical Hardware","Kernel Images","Architectural Framework","System-on-chip","High-level Synthesis"]},{"type":"Author Keywords","kwd":["Near-data processing","multi-level memory hierarchies","hardware development framework","full system simulation"]}],"authorNames":"João Vieira;Nuno Roma;Gabriel Falcao;Pedro Tomás","pubLink":"/xpl/RecentIssue.jsp?punumber=6287639","displayPublicationDate":"11 January 2024","dateOfInsertion":"11 January 2024","allowComments":true,"issueLink":"/xpl/tocresult.jsp?isnumber=10380310&punumber=6287639","doiLink":"https://doi.org/10.1109/ACCESS.2024.3352924","formulaStrippedArticleTitle":"NDPmulator: Enabling Full-System Simulation for Near-Data Accelerators From Caches to DRAM","isGetAddressInfoCaptured":false,"isMarketingOptIn":false,"pubTopics":[{"name":"Aerospace"},{"name":"Bioengineering"},{"name":"Communication, Networking and Broadcast Technologies"},{"name":"Components, Circuits, Devices and Systems"},{"name":"Computing and Processing"},{"name":"Engineered Materials, Dielectrics and Plasmas"},{"name":"Engineering Profession"},{"name":"Fields, Waves and Electromagnetics"},{"name":"General Topics for Engineers"},{"name":"Geoscience"},{"name":"Nuclear Engineering"},{"name":"Photonics and Electrooptics"},{"name":"Power, Energy and Industry Applications"},{"name":"Robotics and Control Systems"},{"name":"Signal Processing and Analysis"},{"name":"Transportation"}],"publisher":"IEEE","isDynamicHtml":true,"displayDocTitle":"NDPmulator: Enabling Full-System Simulation for Near-Data Accelerators From Caches to DRAM","volume":"12","isFreeDocument":true,"isStandard":false,"isTutorial":false,"isProduct":false,"isJournal":true,"isEarlyAccess":false,"isOpenAccess":true,"isEphemera":false,"isConference":false,"isBookWithoutChapters":false,"xploreDocumentType":"Journals & Magazine","isBook":false,"isOnlineOnly":false,"isSpringer":false,"isChapter":false,"isPromo":false,"isLatestStandard":false,"hasStandardVersions":false,"isGiveaway":false,"isTranslation":false,"htmlLink":"/document/10388355/","htmlAbstractLink":"/document/10388355/","isOUP":false,"isSAE":false,"isNow":false,"isSMPTE":false,"persistentLink":"https://ieeexplore.ieee.org/servlet/opac?punumber=6287639","isCustomDenial":false,"isDegruyter":false,"startPage":"10349","fundingAgencies":{"fundingAgency":[{"fundingId":"10.13039/501100001871","fundingName":"Fundação para a Ciência e a Tecnologia (FCT)","grantNumber":"2022.06780.PTDC (DOI: 10.54499/2022.06780.PTDC)"},{"fundingName":"projects","grantNumber":"UIDB/50008/2020, UIDB/50021/2020 (DOI: 10.54499/UIDB/50021/2020), EXPL/EEI-HAC/1511/2021 (DOI: 10.54499/EXPL/EEI-HAC/1511/2021) and 2022.11626.BD"},{"fundingName":"research","grantNumber":"SFRH/BD/144047/2019"},{"fundingName":"European High Performance Computing Joint Undertaking (JU) under Framework Partnership Agreement","grantNumber":"800928"},{"fundingName":"Specific Grant Agreement","grantNumber":"101036168 (EPI SGA2)"},{"fundingName":"European Union’s Horizon 2020 research and innovation programme and from Croatia, France, Germany, Greece, Italy, Netherlands, Portugal, Spain, Sweden, and Switzerland"}]},"subjectCategories":["Circuits and systems","Computers and information processing","Electronic design automation and methodology"],"openAccessFlag":"T","insertDate":"11 January 2024","ephemeraFlag":"false","title":"NDPmulator: Enabling Full-System Simulation for Near-Data Accelerators From Caches to DRAM","html_flag":"false","ml_html_flag":"true","sourcePdf":"access-vieira-3352924-x.pdf","displayPublicationDate":"11 January 2024","mlTime":"PT0.072836S","xplore-pub-id":"6287639","pdfPath":"/iel7/6287639/10380310/10388355.pdf","isNumber":"10380310","contentType":"periodicals","publicationDate":"2024","publicationNumber":"6287639","citationCount":"5","xplore-issue":"10380310","articleId":"10388355","publicationTitle":"IEEE Access","sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"volume":"12","contentTypeDisplay":"Journals","referenceCount":60,"publicationYear":"2024","subType":"IEEE Journal","_value":"CCBY","lastupdate":"2026-09-05","mediaPath":"/mediastore/IEEE/content/media/6287639/10380310/10388355","endPage":"10365","displayPublicationTitle":"IEEE Access","doi":"10.1109/ACCESS.2024.3352924"};


