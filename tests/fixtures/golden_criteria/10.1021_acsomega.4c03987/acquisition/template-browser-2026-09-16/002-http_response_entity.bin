                <h2 scrollto-destination="165496568"  id="165496568" data-section-title="References" class="backreferences-title jumplink-heading">References</h2>
                <div  class="">
                <div id="165496568-content" class="article-section-wrapper js-article-section js-content-section  " data-section-parent-id="0">
                    
                    <div class="ref-list js-splitview-ref-list"><div data-content-id="ref1" xmlns:helper="urn:XsltStringHelper"><div class="ref false"><div class="ref-content "><span class="label title-label">1.</span><div class="ref-body"><div class="citation mixed-citation" id="cit1"><span class="person-group"><span class="name string-name"><div class="surname">Liu</div>, <div class="given-names">L.</div></span>; 
