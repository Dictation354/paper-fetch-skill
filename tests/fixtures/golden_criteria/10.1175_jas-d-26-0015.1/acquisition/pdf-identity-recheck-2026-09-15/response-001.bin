    		<h2 class="itemTitle item-title content-title text-headline mb-2">
    			<a target="_self" href="/view/journals/phoc/53/4/JPO-D-22-0129.1.xml" class="c-Button--link">Do Submesoscales Affect the Large-Scale Structure of the Upper Ocean?</a>
    			
    		</h2>
    		
        </div>
	
    
            
    
		    </div>
		 

    

    

    
	


                    
                     
                        

    

    

	
		 	<div class="component component-content-item component-content-contributors ">
		        
    	
                
        
        
            <div class="content-contributor ">
            	<div class="contributor-line text-subheading">
            	    <div>
                        
                                
            
                
                    
                            <div class="text-subheading">
                                

                
