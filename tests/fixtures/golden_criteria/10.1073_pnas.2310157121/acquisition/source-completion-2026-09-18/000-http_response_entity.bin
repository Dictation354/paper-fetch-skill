{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2026,8,17]],"date-time":"2026-08-17T22:28:53Z","timestamp":1787005733056,"version":"build-2736575974"},"reference-count":88,"publisher":"National Academy of Sciences","issue":"33","license":[{"start":{"date-parts":[[2024,8,5]],"date-time":"2024-08-05T00:00:00Z","timestamp":1722816000000},"content-version":"vor","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"funder":[{"DOI":"10.13039\/100000104","name":"NASA","doi-asserted-by":"publisher","award":["80NM0018D0004"],"award-info":[{"award-number":["80NM0018D0004"]}],"id":[{"id":"10.13039\/100000104","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100000015","name":"U.S. Department of Energy","doi-asserted-by":"publisher","award":["DE-AC02-05CH11231"],"award-info":[{"award-number":["DE-AC02-05CH11231"]}],"id":[{"id":"10.13039\/100000015","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100000104","name":"NASA","doi-asserted-by":"publisher","award":["20-LCLUC2020-0024"],"award-info":[{"award-number":["20-LCLUC2020-0024"]}],"id":[{"id":"10.13039\/100000104","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100006228","name":"DOE | SC | Oak Ridge National Laboratory","doi-asserted-by":"publisher","award":["DE-AC05-00OR22725"],"award-info":[{"award-number":["DE-AC05-00OR22725"]}],"id":[{"id":"10.13039\/100006228","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":["www.pnas.org"],"crossmark-restriction":true},"short-container-title":["Proc. Natl. Acad. Sci. U.S.A."],"published-print":{"date-parts":[[2024,8,13]]},"abstract":"<jats:p>\n                    The Amazon forest contains globally important carbon stocks, but in recent years, atmospheric measurements suggest that it has been releasing more carbon than it has absorbed because of deforestation and forest degradation. Accurately attributing the sources of carbon loss to forest degradation and natural disturbances remains a challenge because of the difficulty of classifying disturbances and simultaneously estimating carbon changes. We used a unique, randomized, repeated, very high-resolution airborne laser scanning survey to provide a direct, detailed, and high-resolution partitioning of aboveground carbon gains and losses in the Brazilian Arc of Deforestation. Our analysis revealed that disturbances directly attributed to human activity impacted 4.2% of the survey area while windthrows and other disturbances affected 2.7% and 14.7%, respectively. Extrapolating the lidar-based statistics to the study area (544,300 km\n                    <jats:sup>2<\/jats:sup>\n                    ), we found that 24.1, 24.2, and 14.5 Tg C y\n                    <jats:sup>\u22121<\/jats:sup>\n                    were lost through clearing, fires, and logging, respectively. The losses due to large windthrows (21.5 Tg C y\n                    <jats:sup>\u22121<\/jats:sup>\n                    ) and other disturbances (50.3 Tg C y\n                    <jats:sup>\u22121<\/jats:sup>\n                    ) were partially counterbalanced by forest growth (44.1 Tg C y\n                    <jats:sup>\u22121<\/jats:sup>\n                    ). Our high-resolution estimates demonstrated a greater loss of carbon through forest degradation than through deforestation and a net loss of carbon of 90.5 \u00b1 16.6 Tg C y\n                    <jats:sup>\u22121<\/jats:sup>\n                    for the study region attributable to both anthropogenic and natural processes. This study highlights the role of forest degradation in the carbon balance for this critical region in the Earth system.\n                  <\/jats:p>","DOI":"10.1073\/pnas.2310157121","type":"journal-article","created":{"date-parts":[[2024,8,5]],"date-time":"2024-08-05T15:05:17Z","timestamp":1722870317000},"update-policy":"https:\/\/doi.org\/10.1073\/pnas.cm10313","source":"Crossref","is-referenced-by-count":41,"title":["A large net carbon loss attributed to anthropogenic and natural disturbances in the Amazon Arc of Deforestation"],"prefix":"10.1073","volume":"121","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-4590-3807","authenticated-orcid":false,"given":"Ovidiu","family":"Csillik","sequence":"first","affiliation":[{"name":"Jet Propulsion Laboratory, California Institute of Technology, Pasadena, CA 91109"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0253-3359","authenticated-orcid":false,"given":"Michael","family":"Keller","sequence":"additional","affiliation":[{"name":"Jet Propulsion Laboratory, California Institute of Technology, Pasadena, CA 91109"},{"name":"International Institute of Tropical Forestry, United Stated Department of Agriculture (USDA) Forest Service, R\u00edo Piedras 00926, Puerto Rico"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Marcos","family":"Longo","sequence":"additional","affiliation":[{"name":"Climate and Ecosystem Sciences Division, Lawrence Berkeley National Laboratory, Berkeley, CA 94720"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Antonio","family":"Ferraz","sequence":"additional","affiliation":[{"name":"Jet Propulsion Laboratory, California Institute of Technology, Pasadena, CA 91109"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Ekena","family":"Rangel Pinag\u00e9","sequence":"additional","affiliation":[{"name":"College of Forestry, Oregon State University, Corvallis, OR 97333"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-2517-0279","authenticated-orcid":false,"given":"Eric Bastos","family":"G\u00f6rgens","sequence":"additional","affiliation":[{"name":"Department of Forest Engineering, Universidade Federal dos Vales do Jequitinhonha e Mucuri, Diamantina, MG 39100-000, Brazil"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jean P.","family":"Ometto","sequence":"additional","affiliation":[{"name":"Earth System Sciences Center, National Institute for Space Research-National Institute for Space Research (INPE), S\u00e3o Jos\u00e9 dos Campos, SP 12227-010, Brazil"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0185-7386","authenticated-orcid":false,"given":"Vinicius","family":"Silgueiro","sequence":"additional","affiliation":[{"name":"Instituto Centro de Vida, Alta Floresta, MT 78580-000, Brazil"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0004-1502-1303","authenticated-orcid":false,"given":"David","family":"Brown","sequence":"additional","affiliation":[{"name":"Neptune and Company, Inc., Lakewood, CO 80215"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0004-8667-2007","authenticated-orcid":false,"given":"Paul","family":"Duffy","sequence":"additional","affiliation":[{"name":"Neptune and Company, Inc., Lakewood, CO 80215"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3464-1151","authenticated-orcid":false,"given":"K. C.","family":"Cushman","sequence":"additional","affiliation":[{"name":"Environmental Sciences Division, Oak Ridge National Laboratory, Oak Ridge, TN 37830"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sassan","family":"Saatchi","sequence":"additional","affiliation":[{"name":"Jet Propulsion Laboratory, California Institute of Technology, Pasadena, CA 91109"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"341","published-online":{"date-parts":[[2024,8,5]]},"reference":[{"key":"e_1_3_4_1_2","doi-asserted-by":"publisher","DOI":"10.1088\/1748-9326\/2\/4\/045023"},{"key":"e_1_3_4_2_2","doi-asserted-by":"publisher","DOI":"10.1038\/nature10425"},{"key":"e_1_3_4_3_2","doi-asserted-by":"publisher","DOI":"10.55161\/AIZJ1133"},{"key":"e_1_3_4_4_2","first-page":"9","article-title":"Post-drought decline 