201/9780429495700" target="_blank">Crossref</a></div><div class="adsDoiReference hide"><a class="openInAnotherWindow" href="http://adsabs.harvard.edu/cgi-bin/basic_connect?qsearch=10.1201%2F9780429495700" target="_blank">Search ADS</a></div><div class="xslopenurl empty-target"><span class="inst-open-url-holders" data-targetId="10.1201%2F9780429495700"> </span></div> </div></div></div></div></div></div><div data-content-id="c68" xmlns:helper="urn:XsltStringHelper"><div class="ref false"><div class="ref-content "><span class="label title-label">68.</span><div class="ref-body"><div class="citation mixed-citation"><span class="name string-name"><div class="given-names">T.</div> <div class="surname">Helgaker</div></span> and <span class="name string-name"><div class="given-names">P.</div> <div class="surname">Jorgensen</div></span>, <div class="source"><em>Molecular Electronic Structure Theory</em></div> (<div class="publisher-name">Wiley</div>, <div class="publisher-loc">New York</div>, <div class="year">2013</div>).<div class="citation-links"><div class="google-scholar-ref-link js-ref-link"><a href="https://scholar.google.com/scholar_lookup?title=Molecular%20Electronic%20Structure%20Theory&amp;author=T.%20Helgaker&amp;author=P.%20Jorgensen&amp;publication_year=2013&amp;book=Molecular%20Electronic%20Structure%20Theory" target="_blank">Google Scholar</a></div> </div></div></div></div></div></div><div data-content-id="c69" xmlns:helper="urn:XsltStringHelper"><div class="ref false"><div class="ref-content "><span class="label title-label">69.</span><div class="ref-body"><div class="citation mixed-citation"><span class="name string-name"><div class="given-names">G. P.</div> <div class="surname">Chen</div></span>, <span class="name string-name"><div class="given-names">V. K.</div> <div class="surname">Voora</div></span>, <span class="name string-name"><div class="given-names">M. M.</div> <div class="surname">Agee</div></span>, <span class="name string-name"><div class="given