er slope &lt;i&gt;q&lt;sub&gt;ξ&lt;\/sub&gt;&lt;\/i&gt; labeled.&lt;\/p&gt;&lt;\/caption&gt;&quot;,&quot;watermarkPath&quot;:&quot;AMS-Logo-Lockup-Journals-01.png&quot;,&quot;currentUri&quot;:&quot;/journals/phoc/55/6/JPO-D-24-0098.1.xml&quot;}]}" aria-selected="false" role="option" data-menu-item="list-id-00266a14-e874-48f6-a03a-7ccb1bf290d7" class="ListItem ListItem--disableGutters ListItem--divider">
