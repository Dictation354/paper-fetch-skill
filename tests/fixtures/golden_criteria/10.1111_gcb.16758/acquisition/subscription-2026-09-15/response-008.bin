        </li>
        <li id="number" class="invalid">
            <span>or a digit</span>
        </li>
    </ul>
    <span class="strength">Too Short</span>
</div>
                        
                    </div>
                    <input class="button primary submit" type="submit" value="Submit" disabled="disabled" /></form>
