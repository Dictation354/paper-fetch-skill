        const resizeAdContainer = (container, height) => {
            if (!container) return;
            container.style.height = `${height + adLabelHeight}px`;
            const iframe = container.querySelector('iframe');
            if (iframe) iframe.style.height = `${height}px`;
        };

        googletag.pubads().addEventListener('slotRenderEnded', (event) => {
            if (event.slot.getSlotElementId() === adSlotId) {
                const container = document.getElementById(adSlotId);
                if (!container) return;

                // Give the creative's own 'expandable' announcement a brief window to
                // arrive first, so an expandable creative's true collapsed default (250)
                // is what actually paints - instead of GAM's registered size (600) for
                // one frame before the message correction snaps it back down.
                setTimeout(() => {
                    if (container.dataset.expandableBound) return;
                    const [, height] = event.size || [300, 250];
                    resizeAdContainer(container, height);
                }, 100);
            }
        });

        window.addEventListener('message', (event) => {
            const { type, source, collapsedHeight, expandedHeight } = event.data || {};
            if (type !== 'expandable' || !source) return;

            const container = document.getElementById(source);
            if (!container || container.dataset.expandableBound) return;

            container.dataset.expandableBound = 'true';

            resizeAdContainer(container, collapsedHeight || 250);
            container.addEventListener('mouseenter', () => resizeAdContainer(container, expandedHeight || 600));
            container.addEventListener('mouseleave', () => resizeAdContainer(container, collapsedHeight || 250));
        });


        // Enable lazy loading: PERICLES-20799 LIT-672701
        googletag.setConfig({
            lazyLoad: {
                fetchMarginPercent: 100,
                renderMarginPercent: 10,
                mobileScaling: 2.0
            }
        });

        googletag.enableServices();
    });

	if (isPubGradeEnabled) {
		var PUBGRADE_TIMEOUT = 2000;  
		var pgAds = pgAds || {};  
		pgAds.loadAds = function() {  
			if (pgAds.loaded) return;  
			pgAds.loaded = true;  
			googletag.cmd.push(function() {  
				if (isProgrammaticAdsEnabled) {
				   apstag.fetchBids({timeout: 2000}, function (bids) {
						apstag.setDisplayBids();
						onDvtagReady(function () {
							setTimeout(() => {
								googletag.pubads().refresh();
							}, 300);
						});
					});
				} else {
					onDvtagReady(function () {
						setTimeout(() => {
							googletag.pubads().refresh();
						}, 300);
					});
				};
			});  
		}  
		// load ads after PubGrade campaigns are initialized  
		document.addEventListener('pbgrdFinished', pgAds.loadAds);  
		// fallback if PubGrade library does not load  
		document.addEventListener('DOMContentLoaded', function () {  
			setTimeout(pgAds.loadAds, PUBGRADE_TIMEOUT);  
		});  
	}
    else if (isProgrammaticAdsEnabled) {
        googletag.cmd.push(function () {
            apstag.fetchBids({timeout: 2000}, function (bids) {
                apstag.setDisplayBids();
                onDvtagReady(function () {
					setTimeout(() => {
						googletag.pubads().refresh();
					}, 300);
                })
            });
        });
    }
</script>

