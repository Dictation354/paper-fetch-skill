<!-- SMS-7376: temporary platform-migration notice. Remove this entire block on ACS request. -->
<script>
    (function () {
        'use strict';

        var ALLOWED_HOSTNAMES = ['pubs.acs.org', 'www.pubs.acs.org'];
        var MIGRATION_PAGE_URL = '/pages/platform-migration';
        var BANNER_ID = 'acs-migration-banner';

        if (ALLOWED_HOSTNAMES.indexOf(window.location.hostname) === -1) {
            return;
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        function init() {
            if (document.getElementById(BANNER_ID)) {
                return;
            }
            var header = document.querySelector('.master-header');
            if (!header) {
                return;
            }
            var sitePageHeader = header.querySelector('.widget-SitePageHeader');
            var adBanner = header.querySelector('.ad-banner');
            if (!sitePageHeader && !adBanner) {
                return;
            }

            injectStyles();
            var banner = buildBanner();
            if (sitePageHeader) {
                header.insertBefore(banner, sitePageHeader);
            } else {
                adBanner.parentNode.insertBefore(banner, adBanner.nextSibling);
            }
        }

        function buildBanner() {
            var banner = document.createElement('section');
            banner.id = BANNER_ID;
            banner.className = 'acs-migration-banner';
            banner.setAttribute('role', 'region');
            banner.setAttribute('aria-label', 'Platform migration notice');

            banner.innerHTML =
                '<div class="acs-migration-banner__inner">' +
                '<div class="acs-migration-banner__content">' +
                '<span class="acs-migration-banner__label">Site Notice</span>' +
                '<p class="acs-migration-banner__message">' +
                'Update: <a class="acs-migration-banner__link" href="/pages/rss">RSS feeds</a> and article metrics are now available. Learn more on our ' +
                '<a class="acs-migration-banner__link" href="' +
                MIGRATION_PAGE_URL +
                '">' +
                'Platform Migration page' +
                '</a>.' +
                '</p>' +
                '</div>' +
                '<button type="button" class="acs-migration-banner__toggle" aria-label="Dismiss notice">Dismiss</button>' +
                '</div>';

            banner
                .querySelector('.acs-migration-banner__toggle')
                .addEventListener('click', function () {
                    if (banner.parentNode) {
                        banner.parentNode.removeChild(banner);
                    }
                });

            return banner;
        }

        function injectStyles() {
            if (document.getElementById('acs-migration-banner-styles')) {
                return;
            }

            var css =
                '.acs-migration-banner{background:#E6EBF6;color:#1a1a1a;' +
                "font-family:'Roboto',Arial,sans-serif;}" +
                '.acs-migration-banner__inner{display:flex;align-items:center;gap:24px;' +
                'max-width:1200px;margin:0 auto;padding:12px 20px;}' +
                '.acs-migration-banner__content{flex:1 1 auto;}' +
                '.acs-migration-banner__label{display:block;font-weight:600;font-size:16px;' +
                'line-height:1.2;}' +
                '.acs-migration-banner__message{margin:7px 0 0;color:#5c5c5c;font-weight:400;' +
                'font-size:16px;line-height:1.4;}' +
                '.acs-migration-banner__link{color:#0039A6;text-decoration:underline;}' +
                '.acs-migration-banner__link:hover,.acs-migration-banner__link:focus{color:#0039A6;}' +
                '.acs-migration-banner__toggle{flex:0 0 auto;width:90px;height:36px;' +
                'background:transparent;color:#0039A6;border:1px solid #0039A6;border-radius:3px;' +
                "font-family:'Roboto',Arial,sans-serif;font-weight:500;font-size:16px;" +
                'cursor:pointer;}' +
                '.acs-migration-banner__toggle:hover,.acs-migration-banner__toggle:focus{' +
                'background:rgba(0,57,166,.08);}' +
                '@media (max-width:600px){' +
                '.acs-migration-banner__inner{flex-direction:column;align-items:flex-start;gap:12px;}' +
                '.acs-migration-banner__toggle{align-self:flex-start;}' +
                '}';

            var style = document.createElement('style');
            style.id = 'acs-migration-banner-styles';
            style.textContent = css;
            document.head.appendChild(style);
        }
    })();
</script>



 
    </div>



