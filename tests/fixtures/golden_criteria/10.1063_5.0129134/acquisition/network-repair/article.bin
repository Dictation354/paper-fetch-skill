<script>
  // Do not show button on my-account pages
  const excludedPath = "https://pubs.aip.org/my-account";

  // Only run if current URL does NOT start with excluded path
  if (!window.location.href.startsWith(excludedPath)) {

    // Create the button dynamically
    const backToTopBtn = document.createElement("button");
    backToTopBtn.id = "backToTopBtn";
    backToTopBtn.title = "Back to top";
    backToTopBtn.setAttribute("aria-label", "Back to top");
    backToTopBtn.innerHTML = "↑ Top";

    document.body.appendChild(backToTopBtn);

    // Show the button only after the user has scrolled
    // either 600px or 40% of the viewport height, whichever is greater
    const showAfter = () => Math.max(600, window.innerHeight * 0.4);

    window.addEventListener("scroll", () => {
      const scrollTop =
        window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > showAfter()) {
        backToTopBtn.classList.add("is-visible");
      } else {
        backToTopBtn.classList.remove("is-visible");
      }
    });

    backToTopBtn.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    });
  }
</script>
<style>
    #backToTopBtn {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 999;
    border: none;
    border-radius: 999px;
    padding: 12px 18px;
    min-height: 48px;
    background: #0F0052;
    color: #FFFF;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.2px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease,
    background-color 0.2s ease,
    box-shadow 0.2s ease;
    }
    #backToTopBtn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    }
    #backToTopBtn:hover, #backToTopBtn:focus-visible {
    background: #2915BC;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    }
    #backToTopBtn:focus-visible {
    outline: 3px solid rgba(0, 87, 146, 0.25);
    outline-offset: 3px;
    }
    @media (max-width: 768px) {
    #backToTopBtn {
    right: 16px;
    bottom: 16px;
    padding: 11px 16px;
    font-size: 15px;
    }
    }
    @media (prefers-reduced-motion: reduce) {
    #backToTopBtn {
    transition: none;
    }
    html {
    scroll-behavior: auto;
    }
    }
</style>
