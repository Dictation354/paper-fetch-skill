{"#text":1320},{"sub":4288},[4289],{"#text":1324},{"#text":4291},", intercellular CO",{"sub":4293},[4294],{"#text":877},{"#text":4296}," concentration; ",{"italic":4298},[4299],{"#text":883},{"sub":4301},[4302],{"#text":1036},{"#text":4304},", leaf temperature; VPD, leaf-to-air vapor pressure deficit.",{"#text":799},{"#text":799},{"graphic":4308,":@":4309},[],{"@_mimetype":396,"@_mime-subtype":4310,"@_xmlns:xlink":4311,"@_xlink:href":4312},"tiff","http://www.w3.org/1999/xlink","fpls-11-01216-g001.tif",{"#text":805},{"@_id":4037,"@_position":4315},"float",{"#text":805},{"table-wrap":4318,":@":5826},[4319,4320,4323,4324,4533,4534,5807,5808,5825],{"#text":799},{"label":4321},[4322],{"#text":4076},{"#text":799},{"caption":4325},[4326,4327,4532],{"#text":1886},{"p":4328},[4329,4331,4334,4335,4338,4340,4343,4346,4348,4351,4354,4356,4359,4362,4363,4366,4369,4370,4373,4376,4377,4380,4384,4385,4388,4392,4393,4396,4400,4401,4404,4407,4409,4412,4413,4416,4419,4420,4423,4426,4428,4432,4434,4437,4440,4441,4444,4447,4448,4483,4484,4519,4521,4524,4525,4528,4531],{"#text":4330},"Parameters of photosynthetic induction since the increase in irradiance from 50 to 1000 μmol m",{"sup":4332},[4333],{"#text":1227},{"#text":1264},{"sup":4336},[4337],{"#text":1233},{"#text":4339}," in four tropical woody species under constant 30°C (",{"italic":4341},[4342],{"#text":883},{"sub":4344},[4345],{"#text":887},{"#text":4347},"), 40°C (",{"italic":4349},[4350],{"#text":883},{"sub":4352},[4353],{"#text":896},{"#text":4355},"), and simulated dynamic temperature condition (",{"italic":4357},[4358],{"#text":883},{"sub":4360},[4361],{"#text":905},{"#text":2396},{"italic":4364},[4365],{"#text":927},{"sub":4367},[4368],{"#text":2316},{"#text":1303},{"italic":4371},[4372],{"#text":927},{"sub":4374},[4375],{"#text":2743},{"#text":1303},{"italic":4378},[4379],{"#text":1283},{"sub":4381},[4382],{"#text":4383},"sw,ini",{"#text":1303},{"italic":4386},[4387],{"#text":1283},{"sub":4389},[4390],{"#text":4391},"sw