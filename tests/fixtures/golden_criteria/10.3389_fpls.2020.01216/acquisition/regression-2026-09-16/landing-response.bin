,{"italic":2341},[2342],{"#text":927},{"#text":2344}," prior to the induction.",{"#text":805},{"p":2347},[2348,2350,2353,2357,2359,2362,2364,2370,2372,2376,2380,2384,2387,2389,2395,2397,2400,2403,2405,2408,2411],{"#text":2349},"To identify the transition point between Rubisco and RuBP regeneration limitation (",{"italic":2351},[2352],{"#text":1320},{"sub":2354},[2355],{"#text":2356},"i,trans",{"#text":2358},") at high temperature, photosynthetic CO",{"sub":2360},[2361],{"#text":877},{"#text":2363}," response curves were fitted after ",{"xref":2365,":@":2368},[2366],{"#text":2367},"Bellasio et al. (2016)",{"@_ref-type":984,"@_rid":2369},"B1",{"#text":2371},", assuming a constant ",{"italic":2373},[2374],{"#text":2375},"R",{"sub":2377},[2378],{"#text":2379},"L",{"italic":2381},[2382],{"#text":2383},": R",{"sub":2385},[2386],{"#text":1832},{"#text":2388}," ratio of 60% (",{"xref":2390,":@":2393},[2391],{"#text":2392},"Way et al., 2019",{"@_ref-type":984,"@_rid":2394},"B49",{"#text":2396},"). ",{"italic":2398},[2399],{"#text":2375},{"sub":2401},[2402],{"#text":1832},{"#text":2404}," was calculated by averaging the readings over the last minute in the dark period during chlorophyll fluorescence measurements. ",{"italic":2406},[2407],{"#text":1320},{"sub":2409},[2410],{"#text":2356},{"#text":2412}," was determined as:",{"#text":805},{"disp-formula":2415},[2416,2417,2421,2422,2576],{"#text":799},{"label":2418},[2419],{"#text":2420},"(3)",{"#text":799},{"mml:math":2423,":@":2574},[2424,2425,2573],{"#text":1886},{"mml:mrow":2426},[2427,2428,2443,2444,2447,2448,2572],{"#text":1890},{"mml:msub":2429},[2430,2431,2434,2435,2442],{"#text":1917},{"mml:mi":2432},[2433],{"#text":1320},{"#text":1917},{"mml:mrow":2436},[2437,2438,2441],{"#text":1921},{"mml:mtext":2439},[2440],{"#text":2356},{"#text":1917},{"#text":1890},{"#text":1890},{"mml:mo":2445},[2446],{"#text":1912},{"#text":1890},{"mml:mfrac":2449},[2450,2451,2526,2527,2571],{"#text":1917},{"mml:mrow":2452},[2453,2454,2458,2459