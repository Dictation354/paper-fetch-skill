"https://www.frontiersin.org/about/frontiers-planet-prize",{"text":107,"url":108,"target":86,"ariaLabel":109},"Press office","https://pressoffice.frontiersin.org/","this link will take you to the Frontiers press office website",{"text":111,"url":112,"target":27,"ariaLabel":113},"Sustainability","https://www.frontiersin.org/about/sustainability","link to information about Frontiers' sustainability",{"text":115,"url":116,"target":86,"ariaLabel":117},"Career opportunities","https://careers.frontiersin.org/","this link will take you to the Frontiers careers website",{"text":119,"url":120,"target":27,"ariaLabel":121},"Contact us","https://www.frontiersin.org/about/contact","this link will take you to the help pages to contact our support team","https://www.frontiersin.org/submission/submit?domainid=1&fieldid=66&specialtyid=0&entitytype=2&entityid=373","https://api.app.sen.science/submission/frontiers/",{"id":125,"name":126,"slug":127,"sections":128},373,"Frontiers in Plant Science","plant-science",[129,133,137,141,145,149,153,157,161,165,169,173,177,181,185,189,193,197,201,205,209,213,217,221],{"id":130,"name":131,"slug":132},1553,"Aquatic Photosynthetic Organisms","aquatic-photosynthetic-organisms",{"id":134,"name":135,"slug":136},1356,"Crop and Product Physiology","crop-and-product-physiology",{"id":138,"name":139,"slug":140},467,"Functional Plant Ecology","functional-plant-ecology",{"id":142,"name":143,"slug":144},2844,"Functional and Applied Plant Genomics","functional-and-applied-plant-genomics",{"id":146,"name":147,"slug":148},2843,"Photosynthesis and Photobiology","photosynthesis-and-photobiology",{"id":150,"name":151,"slug":152},1312,"Plant Abiotic Stress","plant-abiotic-stress",{"id":154,"name":155,"slug":156},2183,"Plant Bioinformatics","plant-bioinformatics",{"id":158,"name":159,"slug":160},589,"Plant Biophysics and Modeling","plant-biophysics-and-modeling",{"id":162,"name":163,"slug":164},560,"Plant Biotechnology","plant-biotechnology",{"id":166,"name":167,"s