093/treephys/tpy078<!--]--><!--]--><!--]--><!--]--></p><ul class="References__links"><!----><li class="References__links__item"><a href="https://doi.org/10.1093/treephys/tpy078" target="_blank" data-event="articleReference-a-crossRef">CrossRef </a></li><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=H..%2BTomimatsu&amp;author=T..%2BSakata&amp;author=H..%2BFukayama&amp;author=Y..%2BTang&amp;publication_year=2019&amp;title=Short-term%2Beffects%2Bof%2Bhigh%2BCO2%2Baccelerate%2Bphotosynthetic%2Binduction%2Bin%2BPopulus%2Bkoreana%2Bx%2Btrichocarpa%2Bwith%2Balways-open%2Bstomata%2Bregardless%2Bof%2Bphenotypic%2Bchanges%2Bin%2Bhigh%2BCO2%2Bgrowth%2Bconditions&amp;journal=Tree+Physiol.&amp;volume=39&amp;pages=474-483" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B43a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B44"><div class="References__label"><p>44</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Urban</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">O.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Košvancová</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">M.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="R