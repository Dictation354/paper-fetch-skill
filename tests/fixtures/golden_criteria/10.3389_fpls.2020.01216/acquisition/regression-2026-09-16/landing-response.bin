t":1917},{"td":6951,":@":6954},[6952],{"#text":6953},"123.7 ± 8.9a",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":6957,":@":6963},[6958,6960],{"#text":6959},"214.0 ± 18.3b ",{"sup":6961},[6962],{"#text":5393},{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1886},{"#text":799},{"@_frame":5806},{"#text":799},{"table-wrap-foot":6970},[6971,6972,7005,7006,7013],{"#text":1886},{"p":6973},[6974,6975,6978,6980,6983,6985,6988,6990,6993,6995,6998,7000,7003],{"#text":2994},{"sub":6976},[6977],{"#text":2743},{"#text":6979}," and V",{"sub":6981},[6982],{"#text":3751},{"#text":6984},", ETR II and V",{"sub":6986},[6987],{"#text":2943},{"#text":6989}," reached at the end of photosynthetic induction, respectively; ETR",{"sub":6991},[6992],{"#text":2505},{"#text":6994},", maximum ETR II reached during photosynthetic induction; ETR",{"sub":6996},[6997],{"#text":6080},{"#text":6999},", the time required for ETR II to reach 50% of full induction; τ",{"sub":7001},[7002],{"#text":537},{"#text":7004},", the apparent time constant of Rubisco activation. Estimation was based on data recorded during chlorophyll flourescence measurements. Values are means of four to six individual seedlings for each species ( ± standard error). Different letters following means indicate significant difference across different temperature conditions within each species, according to a LSD test conducted at P = 0.05 level. Absence of letters denotes absence of significant difference.",{"#text":1886},{"p":7007},[7008,7009,7012],{"#text":1890},{"sup":7010},[7011],{"#text":5393},{"#text":5823},{"#text":799},{"#text":805},{"@_id":6104,"@_position":4315},{"#text":805},{"fig":7018,":@":7127},[7019,7020,7023,7024,7121,7122,7126],{"#text":799},{"label":7021},[7022],{"#text":6119},{"#text":799},{"caption":7025},[7026,7027,7120],{"#text":1886},{"p":7028},[7029,7031,7034,7036,7039,7041,7044,7046,7049,7050,7053,7057,7058,7061,7065,7066,7069,7073,7074,7077,7081,7083,7086,7089,7090,7093,7096,7098,7101,7104,7106,7109,7110,7113,7115,7118],{"#text":7030},"Time courses of ETR II ",{"bold":7032},[7033],{"#text":4168},{"#text":7035},", qP ",{"bold":7037},[7038],{"#text":4179},{"#text":7040},", qL ",{"bold":7042},[7043],{"#text":4190},{"#text":7045},", and NPQ ",{"bold":7047},[7048],{"#text":4201},{"#text":4209},{"italic":7051},[7052],{"#text":1672},{"bold":7054},[7055],{"#text":7056},"(A, E, I, M)",{"#text":1303},{"italic":7059},[7060],{"#text":1677},{"bold":7062},[7063],{"#text":7064},"(B, F, J, N)",{"#text":1303},{"italic":7067},[7068],{"#text":1682},{"bold":7070},[7071],{"#text":7072},"(C, G, K, O)",{"#text":1684},{"italic":7075},[7076],{"#text":1688},{"bold":7078},[7079],{"#text":7080},"(D, H, L, P)",{"#text":7082},". Values are the means ( ± SE) of three to six individual seedlings for each species under constant 30°C (",{"italic":7084},[7085],{"#text":883},{"sub":7087},[7088],{"#text":887},{"#text":889},{"italic":7091},[7092],{"#text":883},{"sub":7094},[7095],{"#text":896},{"#text":7097},") and dynamic temperature condition (",{"italic":7099},[7100],{"#text":883},{"sub":7102},[7103],{"#text":905},{"#text":7105},"). NPQ in ",{"italic":7107},[7108],{"#text":1677},{"#text":1417},{"italic":7111},[7112],{"#text":1688},{"#text":7114}," was not shown due to insufficient replicates (n \u003C 3, see ",{"italic":7116},[7117],{"#text":1158},{"#text":7119},"). ETR II, electron transport rate of photosystem II; qP and qL are photochemical quenching based on the puddle and the lake model, respectively; NPQ, non-photochemical quenching.",{"#text":799},{"#text":799},{"graphic":7123,":@":7124},[],{"@_mimetype":396,"@_mime-subtype":4310,"@_xlink:href":7125},"fpls-11-01216-g002.tif",{"#text":805},{"@_id":6121,"@_position":4315},{"#text":805},{"p":7130},[7131,7133,7136,7139,7141,7144,7147,7148,7151,7154,7156,7159,7162,7163,7169,7171,7174,7177,7179,7182,7184,7187,7190,7192,7195,7197,7200,7203,7205,7208],{"#text":7132},"Steady-state ",{"italic":7134},[7135],{"#text":2478},{"sub":7137},[7138],{"#text":2943},{"#text":7140}," reached at the end of induction was higher under ",{"italic":7142},[7143],{"#text":883},{"sub":7145},[7146],{"#text":905},{"#text":1417},{"italic":7149},[7150],{"#text":883},{"sub":7152},[7153],{"#text":896},{"#text":7155}," than that under ",{"italic":7157},[7158],{"#text":883},{"sub":7160},[7161],{"#text":887},{"#text":2936},{"xref":7164,":@":7168},[7165],{"bold":7166},[7167],{"#text":6102},{"@_ref-type":4078,"@_rid":6104},{"#text":7170},"). The time constants of Rubisco activation were larger under ",{"italic":7172},[7173],{"#text":883},{"sub":7175},[7176],{"#text":896},{"#text":7178}," in all species, except for a small decrease in ",{"italic":7180},[7181],{"#text":1672},{"#text":7183},". In comparison with ",{"italic":7185},[7186],{"#text":883},{"sub":7188},[7189],{"#text":887},{"#text":7191},", τ",{"sub":7193},[7194],{"#text":537},{"#text":7196}," decreased under ",{"italic":7198},[7199],{"#text":883},{"sub":7201},[7202],{"#text":905},{"#text":7204}," in all species, except for a small increase in ",{"italic":7206},[7207],{"#text":1682},{"#text":2632},{"#text":963},{"@_id":7211},"s3_2",{"#text":963},{"sec":7214,":@":7634},[7215,7216,7220,7221,7359,7360,7507,7508,7633],{"#text":805},{"title":7217},[7218],{"#text":7219},"Primary Limiting Factor During Photosynthetic Induction",{"#text":805},{"p":7222},[7223,7225,7233,7235,7238,7241,7243,7246,7248,7251,7253,7256,7259,7261,7268,7270,7273,7274,7277,7280,7282,7285,7288,7290,7293,7296,7298,7301,7304,7306,7309,7312,7314,7317,7320,7321,7327,7329,7332,7334,7337,7340,7342,7345,7348,7350,7358],{"#text":7224},"As shown in ",{"xref":7226,":@":7231},[7227],{"bold":7228},[7229],{"#text":7230},"Figure 3",{"@_ref-type":4036,"@_rid":7232},"f3",{"#text":7234},", estimated ",{"italic":7236},[7237],{"#text":927},{"sub":7239},[7240],{"#text":2943},{"#text":7242}," matched the time course of measured ",{"italic":7244},[7245],{"#text":927},{"#text":7247},". We noted that ",{"italic":7249},[7250],{"#text":927},{"#text":7252}," was limited by ",{"italic":7254},[7255],{"#text":927},{"sub":7257},[7258],{"#text":2926},{"#text":7260}," only for the first several min (",{"xref":7262,":@":7267},[7263],{"bold":7264},[7265],{"#text":7266},"Figure S3",{"@_ref-type":1406,"@_rid":1407},{"#text":7269},"), after which ",{"italic":7271},[7272],{"#text":927},{"#text":7252},{"italic":7275},[7276],{"#text":927},{"sub":7278},[7279],{"#text":2943},{"#text":7281}," instead. The averaged time length of ",{"italic":7283},[7284],{"#text":927},{"sub":7286},[7287],{"#text":2926},{"#text":7289}," limitation ranged from 1.4 to 2.7 min under ",{"italic":7291},[7292],{"#text":883},{"sub":7294},[7295],{"#text":887},{"#text":7297},", while the rest of photosynthetic induction was occupied by ",{"italic":7299},[7300],{"#text":927},{"sub":7302},[7303],{"#text":2943},{"#text":7305}," limitation. Limitation from ",{"italic":7307},[7308],{"#text":927},{"sub":7310},[7311],{"#text":2943},{"#text":7313}," almost dominated the entire induction process under ",{"italic":7315},[7316],{"#text":883},{"sub":7318},[7319],{"#text":896},{"#text":2936},{"xref":7322,":@":7326},[7323],{"bold":7324},[7325],{"#text":7266},{"@_ref-type":1406,"@_rid":1407},{"#text":7328},"). This was consistent with CO",{"sub":7330},[7331],{"#text":877},{"#text":7333}," response curves obtained at ",{"italic":7335},[7336],{"#text":883},{"sub":7338},[7339],{"#text":896},{"#text":7341},", as the transition point between Rubisco and RuBP regeneration limitation was much higher than transient ",{"italic":7343},[7344],{"#text":1320},{"sub":7346},[7347],{"#text":1324},{"#text":7349}," during induction in all species (",{"xref":7351,":@":7356},[7352],{"bold":7353},[7354],{"#text":7355},"Figure 4",{"@_ref-type":4036,"@_rid":7357},"f4",{"#text":1024},{"#text":805},{"fig":7361,":@":7506},[7362,7363,7366,7367,7500,7501,7505],{"#text":799},{"label":7364},[7365],{"#text":7230},{"#text":799},{"caption":7368},[7369,7370,7499],{"#text":1886},{"p":7371},[7372,7374,7377,7379,7382,7385,7387,7390,7393,7395,7398,7402,7403,7406,7410,7411,7414,7418,7419,7422,7426,7428,7431,7434,7437,7439,7442,7445,7448,7450,7453,7456,7459,7461,7464,7466,7469,7472,7473,7476,7479,7481,7484,7486,7489,7492,7494,7497],{"#text":7373},"Representative time courses of measured ",{"italic":7375},[7376],{"#text":927},{"#text":7378}," (open symbols), estimated ",{"italic":7380},[7381],{"#text":927},{"sub":7383},[7384],{"#text":2943},{"#text":7386}," (red solid line), and estimated ",{"italic":7388},[7389],{"#text":927},{"sub":7391},[7392],{"#text":2926},{"#text":7394}," (orange symbols with solid line) during photosynthetic induction in ",{"italic":7396},[7397],{"#text":1672},{"bold":7399},[7400],{"#text":7401},"(A, E, I)",{"#text":1303},{"italic":7404},[7405],{"#text":1677},{"bold":7407},[7408],{"#text":7409},"(B, F, J)",{"#text":1303},{"italic":7412},[7413],{"#text":1682},{"bold":7415},[7416],{"#text":7417},"(C, G, K)",{"#text":1684},{"italic":7420},[7421],{"#text":1688},{"bold":7423},[7424],{"#text":7425},"(D, H, L)",{"#text":7427}," under constant 30°C [",{"italic":7429},[7430],{"#text":883},{"sub":7432},[7433],{"#text":887},{"bold":7435},[7436],{"#text":4168},{"#text":7438},"] simulated dynamic temperature [",{"italic":7440},[7441],{"#text":883},{"sub":7443},[7444],{"#text":905},{"bold":7446},[7447],{"#text":4179},{"#text":7449},"] and constant 40°C condition [",{"italic":7451},[7452],{"#text":883},{"sub":7454},[7455],{"#text":896},{"bold":7457},[7458],{"#text":4190},{"#text":7460},"], respectively. Measured ",{"italic":7462},[7463],{"#text":927},{"#text":7465}," were those simultaneously recorded during chlorophyll fluorescence measurements. Estimated ",{"italic":7467},[7468],{"#text":927},{"sub":7470},[7471],{"#text":2943},{"#text":1417},{"italic":7474},[7475],{"#text":927},{"sub":7477},[7478],{"#text":2926},{"#text":7480}," were the potential ",{"italic":7482},[7483],{"#text":927},{"#text":7485}," supported by ",{"italic":7487},[7488],{"#text":2478},{"sub":7490},[7491],{"#text":2943},{"#text":7493}," and ETR II, respectively. Periodic oscillations of ",{"italic":7495},[7496],{"#text":927},{"#text":7498}," were inevitable due to the periodic dark pulses necessary for determining fluorescence yield.",{"#text":799},{"#text":799},{"graphic":7502,":@":7503},[],{"@_mimetype":396,"@_mime-subtype":4310,"@_xlink:href":7504},"fpls-11-01216-g003.tif",{"#text":805},{"@_id":7232,"@_position":4315},{"#text":805},{"fig":7509,":@":7632},[7510,7511,7514,7515,7626,7627,7631],{"#text":799},{"label":7512},[7513],{"#text":7355},{"#text":799},{"caption":7516},[7517,7518,7625],{"#text":1886},{"p":7519},[7520,7522,7525,7527,7530,7533,7535,7538,7542,7543,7546,7550,7551,7554,7558,7559,7562,7566,7568,7571,7573,7576,7577,7580,7582,7586,7588,7591,7593,7596,7599,7601,7604,7607,7609,7612,7613,7616,7619,7620,7623],{"#text":7521},"Photosynthetic CO",{"sub":7523},[7524],{"#text":877},{"#text":7526}," response curve at high temperature (",{"italic":7528},[7529],{"#text":883},{"sub":7531},[7532],{"#text":896},{"#text":7534},") in ",{"italic":7536},[7537],{"#text":1672},{"bold":7539},[7540],{"#text":7541},"(A)",{"#text":1303},{"italic":7544},[7545],{"#text":1677},{"bold":7547},[7548],{"#text":7549},"(B)",{"#text":1303},{"italic":7552},[7553],{"#text":1682},{"bold":7555},[7556],{"#text":7557},"(C)",{"#text":1684},{"italic":7560},[7561],{"#text":1688},{"bold":7563},[7564],{"#text":7565},"(D)",{"#text":7567},". Assimilation rate (",{"italic":7569},[7570],{"#text":927},{"#text":7572},") was recorded under 1000 μmol m",{"sup":7574},[7575],{"#text":1227},{"#text":1264},{"sup":7578},[7579],{"#text":1233},{"#text":7581}," at an average leaf temperature of 36.7°C.The ",{"italic":7583},[7584],{"#text":7585},"x",{"#text":7587},"-intercept of vertical dotted lines represents the averaged transition CO",{"sub":7589},[7590],{"#text":877},{"#text":7592}," concentration in each species, above which the primary limitation imposed on photosynthesis switched from ",{"italic":7594},[7595],{"#text":927},{"sub":7597},[7598],{"#text":2943},{"#text":7600}," to ",{"italic":7602},[7603],{"#text":927},{"sub":7605},[7606],{"#text":2926},{"#text":7608},". Values are the means ( ± SE) of five to six individual seedlings for each species. ",{"italic":7610},[7611],{"#text":927},{"#text":4270},{"italic":7614},[7615],{"#text":1320},{"sub":7617},[7618],{"#text":1324},{"#text":4291},{"sub":7621},[7622],{"#text":877},{"#text":7624}," concentration.",{"#text":799},{"#text":799},{"graphic":7628,":@":7629},[],{"@_mimetype":396,"@_mime-subtype":4310,"@_xlink:href":7630},"fpls-11-01216-g004.tif",{"#text":805},{"@_id":7357,"@_position":4315},{"#text":963},{"@_id":7635},"s3_3",{"#text":963},{"sec":7638,":@":7809},[7639,7640,7644,7645,7749,7750,7808],{"#text":805},{"title":7641},[7642],{"#text":7643},"Carbon Gain",{"#text":805},{"p":7646},[7647,7649,7652,7655,7657,7660,7663,7664,7672,7674,7677,7680,7682,7685,7688,7690,7693,7696,7697,7700,7703,7705,7709,7711,7714,7717,7718,7721,7724,7726,7729,7732,7734,7737,7740,7741,7744,7747],{"#text":7648},"ICG within the first 5 min under ",{"italic":7650},[7651],{"#text":883},{"sub":7653},[7654],{"#text":896},{"#text":7656}," was 45–83% of that under ",{"italic":7658},[7659],{"#text":883},{"sub":7661},[7662],{"#text":887},{"#text":2936},{"xref":7665,":@":7670},[7666],{"bold":7667},[7668],{"#text":7669},"Figure 5",{"@_ref-type":4036,"@_rid":7671},"f5",{"#text":7673},"). However, ICG within the first minute increased by 38–153% under ",{"italic":7675},[7676],{"#text":883},{"sub":7678},[7679],{"#text":905},{"#text":7681}," compared to that under ",{"italic":7683},[7684],{"#text":883},{"sub":7686},[7687],{"#text":887},{"#text":7689},". The differences in ICG between ",{"italic":7691},[7692],{"#text":883},{"sub":7694},[7695],{"#text":905},{"#text":1417},{"italic":7698},[7699],{"#text":883},{"sub":7701},[7702],{"#text":887},{"#text":7704}," decreased as the integration interval increased. ICG over 30 min (ICG",{"sub":7706},[7707],{"#text":7708},"30min",{"#text":7710},") was 20–38% lower under ",{"italic":7712},[7713],{"#text":883},{"sub":7715},[7716],{"#text":905},{"#text":7155},{"italic":7719},[7720],{"#text":883},{"sub":7722},[7723],{"#text":887},{"#text":7725},". The shade-tolerant species showed larger increments in ICG under ",{"italic":7727},[7728],{"#text":883},{"sub":7730},[7731],{"#text":905},{"#text":7733}," and smaller decreases under both ",{"italic":7735},[7736],{"#text":883},{"sub":7738},[7739],{"#text":905},{"#text":1417},{"italic":7742},[7743],{"#text":883},{"sub":7745},[7746],{"#text":896},{"#text":7748}," than the shade-intolerant species.",{"#text":805},{"fig":7751,":@":7807},[7752,7753,7756,7757,7801,7802,7806],{"#text":799},{"label":7754},[7755],{"#text":7669},{"#text":799},{"caption":7758},[7759,7760,7800],{"#text":1886},{"p":7761},[7762,7764,7767,7770,7773,7775,7778,7781,7784,7786,7789,7792,7794,7798],{"#text":7763},"ICG under simulated dynamic temperature condition [",{"italic":7765},[7766],{"#text":883},{"sub":7768},[7769],{"#text":905},{"bold":7771},[7772],{"#text":7541},{"#text":7774},"] and under constant 40°C [",{"italic":7776},[7777],{"#text":883},{"sub":7779},[7780],{"#text":896},{"bold":7782},[7783],{"#text":7549},{"#text":7785},"] relative to that under constant 30°C (",{"italic":7787},[7788],{"#text":883},{"sub":7790},[7791],{"#text":887},{"#text":7793},") as a function of the time since light increased in tree seedlings of four tropical woody species. Shown are data recorded during gas exchange only measurements. The dotted lines indicate equal amount of ICG between two temperature conditions. Open and closed symbols represent data from shade-intolerant and shade-tolerant species, respectively. Values are the means ( ± SE) of five to six individual seedlings for each species. No significant differences were found across species at ",{"italic":7795},[7796],{"#text":7797},"P",{"#text":7799}," = 0.05 level.",{"#text":799},{"#text":799},{"graphic":7803,":@":7804},[],{"@_mimetype":396,"@_mime-subtype":4310,"@_xlink:href":7805},"fpls-11-01216-g005.tif",{"#text":805},{"@_id":7671,"@_position":4315},{"#text":963},{"@_id":7810},"s3_4",{"#text":963},{"sec":7813,":@":8358},[7814,7815,7819,7820,7910,7911,8357],{"#text":805},{"title":7816},[7817],{"#text":7818},"The Effects of Species-Specific Shade Tolerance and Growth Light Environment",{"#text":805},{"p":7821},[7822,7824,7827,7830,7832,7867,7869,7873,7874,7877,7880,7882,7890,7892,7895,7897,7900,7902,7909],{"#text":7823},"In comparison with ",{"italic":7825},[7826],{"#text":883},{"sub":7828},[7829],{"#text":887},{"#text":7831},", increments in ",{"inline-formula":7833},[7834],{"mml:math":7835,":@":7865},[7836],{"mml:mrow":7837},[7838],{"mml:msub":7839},[7840,7860],{"mml:mrow":7841},[7842],{"mml:mfrac":7843},[7844,7852],{"mml:mrow":7845},[7846,7849],{"mml:mi":7847},[7848],{"#text":1832},{"mml:mi":7850},[7851],{"#text":927},{"mml:mrow":7853},[7854,7857],{"mml:mi":7855},[7856],{"#text":1832},{"mml:mi":7858},[7859],{"#text":1844},{"mml:mrow":7861},[7862],{"mml:mi":7863},[7864],{"#text":1850},{"@_display":1856,"@_id":7866},"im11",{"#text":7868}," and ICG",{"sub":7870},[7871],{"#text":7872},"1min",{"#text":4131},{"italic":7875},[7876],{"#text":883},{"sub":7878},[7879],{"#text":905},{"#text":7881}," were significantly related to species-specific shade tolerance (",{"xref":7883,":@":7888},[7884],{"bold":7885},[7886],{"#text":7887},"Table 3",{"@_ref-type":4078,"@_rid":7889},"T3",{"#text":7891},"). The decrease in IT",{"sub":7893},[7894],{"#text":4431},{"#text":7896}," was related to individual averaged DLI, as seedlings with low DLI showed greater reduction in ETR",{"sub":7898},[7899],{"#text":2743},{"#text":7901}," than those with high DLI (",{"xref":7903,":@":7908},[7904],{"bold":7905},[7906],{"#text":7907},"Figure S4",{"@_ref-type":1406,"@_rid":1407},{"#text":1024},{"#text":805},{"table-wrap":7912,":@":8356},[7913,7914,7917,7918,7945,7946,8346,8347,8355],{"#text":799},{"label":7915},[7916],{"#text":7887},{"#text":799},{"caption":7919},[7920,7921,7944],{"#text":1886},{"p":7922},[7923,7925,7928,7930,7933,7936,7937,7940,7943],{"#text":7924},"The influences of species-specific shade tolerance (",{"italic":7926},[7927],{"#text":3981},{"#text":7929},") and average DLI on the differences in induction responses between ",{"italic":7931},[7932],{"#text":883},{"sub":7934},[7935],{"#text":887},{"#text":1417},{"italic":7938},[7939],{"#text":883},{"sub":7941},[7942],{"#text":905},{"#text":2632},{"#text":799},{"#text":799},{"table":7947,":@":8345},[7948,7949,8000,8001,8344],{"#text":1886},{"thead":7950},[7951,7952,7965,7966,7999],{"#text":1890},{"tr":7953},[7954,7955,7958,7959,7964],{"#text":1917},{"th":7956,":@":7957},[],{"@_valign":4548,"@_align":4549},{"#text":1917},{"th":7960,":@":7963},[7961],{"#text":7962},"Factors",{"@_valign":4548,"@_colspan":777,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":7967},[7968,7969,7972,7973,7982,7983,7988,7989,7998],{"#text":1917},{"th":7970,":@":7971},[],{"@_valign":4548,"@_align":4549},{"#text":1917},{"th":7974,":@":7981},[7975,7977,7980],{"#text":7976},"Species-specific shade tolerance (",{"italic":7978},[7979],{"#text":3981},{"#text":1854},{"@_valign":4548,"@_align":4556},{"#text":1917},{"th":7984,":@":7987},[7985],{"#text":7986},"Average daily light integral (DLI)",{"@_valign":4548,"@_align":4556},{"#text":1917},{"th":7990,":@":7997},[7991,7992,7995],{"#text":1921},{"italic":7993},[7994],{"#text":3981},{"#text":7996}," × DLI",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1886},{"#text":1886},{"tbody":8002},[8003,8004,8033,8034,8118,8119,8148,8149,8183,8184,8213,8214,8248,8249,8283,8284,8313,8314,8343],{"#text":1890},{"tr":8005},[8006,8007,8014,8015,8020,8021,8026,8027,8032],{"#text":1917},{"td":8008,":@":8013},[8009,8010],{"#text":4639},{"sub":8011},[8012],{"#text":4431},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8016,":@":8019},[8017],{"#text":8018},"1.399",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8022,":@":8025},[8023],{"#text":8024},"1.600",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8028,":@":8031},[8029],{"#text":8030},"2.664",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8035},[8036,8037,8099,8100,8105,8106,8111,8112,8117],{"#text":1917},{"td":8038,":@":8098},[8039,8040,8097],{"#text":1921},{"inline-formula":8041},[8042,8043,8096],{"#text":1925},{"mml:math":8044,":@":8094},[8045,8046,8093],{"#text":1977},{"mml:mrow":8047},[8048,8049,8092],{"#text":1994},{"mml:msub":8050},[8051,8052,8083,8084,8091],{"#text":3565},{"mml:mrow":8053},[8054,8055,8082],{"#text":4663},{"mml:mfrac":8056},[8057,8058,8069,8070,8081],{"#text":4667},{"mml:mrow":8059},[8060,8061,8064,8065,8068],{"#text":4671},{"mml:mi":8062},[8063],{"#text":1832},{"#text":4671},{"mml:mi":8066},[8067],{"#text":927},{"#text":4667},{"#text":4667},{"mml:mrow":8071},[8072,8073,8076,8077,8080],{"#text":4671},{"mml:mi":8074},[8075],{"#text":1832},{"#text":4671},{"mml:mi":8078},[8079],{"#text":1844},{"#text":4667},{"#text":4663},{"#text":3565},{"#text":3565},{"mml:mrow":8085},[8086,8087,8090],{"#text":4663},{"mml:mi":8088},[8089],{"#text":1850},{"#text":3565},{"#text":1994},{"#text":1977},{"#text":1925},{"@_display":1856,"@_id":8095},"im12",{"#text":1921},{"#text":1917},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8101,":@":8104},[8102],{"#text":8103},"5.731*",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8107,":@":8110},[8108],{"#text":8109},"0.073",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8113,":@":8116},[8114],{"#text":8115},"0.334",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8120},[8121,8122,8129,8130,8135,8136,8141,8142,8147],{"#text":1917},{"td":8123,":@":8128},[8124,8125],{"#text":2994},{"sub":8126},[8127],{"#text":6080},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8131,":@":8134},[8132],{"#text":8133},"4.032",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8137,":@":8140},[8138],{"#text":8139},"3.698",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8143,":@":8146},[8144],{"#text":8145},"4.812*",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8150},[8151,8152,8164,8165,8170,8171,8176,8177,8182],{"#text":1917},{"td":8153,":@":8163},[8154,8155,8158,8159,8162],{"#text":1921},{"italic":8156},[8157],{"#text":2829},{"#text":1921},{"sub":8160},[8161],{"#text":537},{"#text":1917},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8166,":@":8169},[8167],{"#text":8168},"0.054",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8172,":@":8175},[8173],{"#text":8174},"0.012",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8178,":@":8181},[8179],{"#text":8180},"0.533",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8185},[8186,8187,8194,8195,8200,8201,8206,8207,8212],{"#text":1917},{"td":8188,":@":8193},[8189,8190],{"#text":2218},{"sub":8191},[8192],{"#text":7872},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8196,":@":8199},[8197],{"#text":8198},"5.455*",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8202,":@":8205},[8203],{"#text":8204},"0.444",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8208,":@":8211},[8209],{"#text":8210},"0.006",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8215},[8216,8217,8229,8230,8235,8236,8241,8242,8247],{"#text":1917},{"td":8218,":@":8228},[8219,8220,8223,8224,8227],{"#text":1921},{"italic":8221},[8222],{"#text":927},{"#text":1921},{"sub":8225},[8226],{"#text":2743},{"#text":1917},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8231,":@":8234},[8232],{"#text":8233},"1.799",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8237,":@":8240},[8238],{"#text":8239},"0.484",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8243,":@":8246},[8244],{"#text":8245},"1.311",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8250},[8251,8252,8264,8265,8270,8271,8276,8277,8282],{"#text":1917},{"td":8253,":@":8263},[8254,8255,8258,8259,8262],{"#text":1921},{"italic":8256},[8257],{"#text":1283},{"#text":1921},{"sub":8260},[8261],{"#text":4391},{"#text":1917},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8266,":@":8269},[8267],{"#text":8268},"1.217",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8272,":@":8275},[8273],{"#text":8274},"0.804",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8278,":@":8281},[8279],{"#text":8280},"1.044",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8285},[8286,8287,8294,8295,8300,8301,8306,8307,8312],{"#text":1917},{"td":8288,":@":8293},[8289,8290],{"#text":2994},{"sub":8291},[8292],{"#text":2743},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8296,":@":8299},[8297],{"#text":8298},"0.141",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8302,":@":8305},[8303],{"#text":8304},"14.052**",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8308,":@":8311},[8309],{"#text":8310},"0.329",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1890},{"tr":8315},[8316,8317,8324,8325,8330,8331,8336,8337,8342],{"#text":1917},{"td":8318,":@":8323},[8319,8320],{"#text":2218},{"sub":8321},[8322],{"#text":7708},{"@_valign":4548,"@_align":4549},{"#text":1917},{"td":8326,":@":8329},[8327],{"#text":8328},"0.922",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8332,":@":8335},[8333],{"#text":8334},"0.041",{"@_valign":4548,"@_align":4556},{"#text":1917},{"td":8338,":@":8341},[8339],{"#text":8340},"0.241",{"@_valign":4548,"@_align":4556},{"#text":1890},{"#text":1886},{"#text":799},{"@_frame":5806},{"#text":799},{"table-wrap-foot":8348},[8349,8350,8354],{"#text":1886},{"p":8351},[8352],{"#text":8353},"The differences in induction responses were represented as the percentage change of a parameter. Shown are F statistics followed by significance symbols, which are *P \u003C 0.05 and **P \u003C 0.01 respectively.",{"#text":799},{"#text":805},{"@_id":7889,"@_position":4315},{"#text":963},{"@_id":8359},"s3_5",{"#text":966},{"@_id":8362,"@_sec-type":8363},"s3","results",{"#text":966},{"sec":8366,":@":9259,"anchorId":9260},[8367,8368,8372,8373,8478,8479,8817,8818,9123,9124,9258],{"#text":963},{"title":8369},[8370],{"#text":8371},"Discussion",{"#text":963},{"sec":8374,":@":8476},[8375,8376,8380,8381,8475],{"#text":805},{"title":8377},[8378],{"#text":8379},"A Gradual Increase in Leaf Temperature Affects Photosynthetic Induction Process",{"#text":805},{"p":8382},[8383,8385,8389,8391,8395,8396,8400,8402,8408,8410,8413,8415,8450,8451,8457,8459,8465,8467,8473],{"#text":8384},"Photosynthesis consists of a number of temperature-dependent biochemical processes (",{"xref":8386,":@":8388},[8387],{"#text":1088},{"@_ref-type":984,"@_rid":1090},{"#text":8390},"), and the induction process of photosynthesis thus depends on temperature. Recent studies showed that photosynthetic induction can be greatly altered by steady-state environmental temperature (",{"xref":8392,":@":8394},[8393],{"#text":1101},{"@_ref-type":984,"@_rid":1103},{"#text":987},{"xref":8397,":@":8399},[8398],{"#text":1108},{"@_ref-type":984,"@_rid":1110},{"#text":8401},"). It is however important to know how changing leaf temperature, accompanied with light changes, would affect photosynthetic induction rate. By comparing gradually increasing leaf temperature with two constant leaf temperatures after an increase in light, it is evident that an elevating leaf temperature from 30 to 40°C accelerates photosynthetic rate at the early-stage induction more than the two extreme constant temperatures of 30 and 40°C (",{"xref":8403,":@":8407},[8404],{"bold":8405},[8406],{"#text":4034},{"@_ref-type":4036,"@_rid":4037},{"#text":8409},"). This conclusion can be confirmed by the smaller IT",{"sub":8411},[8412],{"#text":4431},{"#text":8414}," and larger ",{"inline-formula":8416},[8417],{"mml:math":8418,":@":8448},[8419],{"mml:mrow":8420},[8421],{"mml:msub":8422},[8423,8443],{"mml:mrow":8424},[8425],{"mml:mfrac":8426},[8427,8435],{"mml:mrow":8428},[8429,8432],{"mml:mi":8430},[8431],{"#text":1832},{"mml:mi":8433},[8434],{"#text":927},{"mml:mrow":8436},[8437,8440],{"mml:mi":8438},[8439],{"#text":1832},{"mml:mi":8441},[8442],{"#text":1844},{"mml:mrow":8444},[8445],{"mml:mi":8446},[8447],{"#text":1850},{"@_display":1856,"@_id":8449},"im13",{"#text":2936},{"xref":8452,":@":8456},[8453],{"bold":8454},[8455],{"#text":4076},{"@_ref-type":4078,"@_rid":4079},{"#text":8458},"). The increase in simulated ETR at the early stage of the induction response also supports the conclusion (",{"xref":8460,":@":8464},[8461],{"bold":8462},[8463],{"#text":6119},{"@_ref-type":4036,"@_rid":6121},{"#text":8466},"). It should be also noticed that photosynthetic rate reached the steady-state much faster under the gradual increasing leaf temperature than either constant leaf temperatures, particularly in the shade-tolerant species (",{"xref":8468,":@":8472},[8469],{"bold":8470},[8471],{"#text":4034},{"@_ref-type":4036,"@_rid":4037},{"#text":8474},"). A full induction state of photosynthetic rate was achieved (within 2–3 min often) even before the leaf temperature reached its steady-state (about 10 min). This fact may indicate that a combined effect of changing leaf temperature, associated with an increase in light, on photosynthetic induction could include some different thermal processes rather than only under constant temperature conditions, which, to our knowledge, is being observed for the first time and deserves further clarification.",{"#text":963},{"@_id":8477},"s4_1",{"#text":963},{"sec":8480,":@":8815},[8481,8482,8486,8487,8535,8536,8617,8618,8725,8726,8814],{"#text":805},{"title":8483},[8484],{"#text":8485},"Factors Involved in the Induction Process Under Different Temperature Conditions",{"#text":805},{"p":8488},[8489,8491,8497,8498,8502,8503,8509,8511,8515,8516,8520,8521,8525,8527,8530,8533],{"#text":8490},"During the first several min after an increase in light intensity, the increase in photosynthetic rate is often constrained by RuBP regeneration, which is further limited by ETR, light activation of Rubisco, and stomatal opening (",{"xref":8492,":@":8495},[8493],{"#text":8494},"Way and Pearcy, 2012",{"@_ref-type":984,"@_rid":8496},"B48",{"#text":987},{"xref":8499,":@":8501},[8500],{"#text":1006},{"@_ref-type":984,"@_rid":1008},{"#text":987},{"xref":8504,":@":8507},[8505],{"#text":8506},"Yamori et al., 2020",{"@_ref-type":984,"@_rid":8508},"B55",{"#text":8510},"). All these factors are thermal sensitive, but the time constants of temperature and light stimulations could be considerably different (",{"xref":8512,":@":8514},[8513],{"#text":1064},{"@_ref-type":984,"@_rid":1066},{"#text":987},{"xref":8517,":@":8519},[8518],{"#text":1101},{"@_ref-type":984,"@_rid":1103},{"#text":987},{"xref":8522,":@":8524},[8523],{"#text":1108},{"@_ref-type":984,"@_rid":1110},{"#text":8526},"). It is difficult to elucidate individual effects of these factors only based on the gas change and chlorophyll fluorescence observations in this study. We tried to address how these factors contribute to photosynthetic induction under ",{"italic":8528},[8529],{"#text":883},{"sub":8531},[8532],{"#text":905},{"#text":8534}," using photosynthetic limitation analysis.",{"#text":805},{"p":8537},[8538,8540,8546,8548,8551,8554,8556,8559,8562,8563,8569,8570,8576,8578,8584,8585,8589,8591,8594,8595,8598,8601,8603,8606,8609,8611,8615],{"#text":8539},"The acceleration of linear electron transport between photosystem II and I plays an evident role in the acceleration of early-stage induction of photosynthetic rate after increase of light, particularly in the shade-intolerant species (",{"xref":8541,":@":8545},[8542],{"bold":8543},[8544],{"#text":6102},{"@_ref-type":4078,"@_rid":6104},{"#text":8547},"). In this study, the limitation of ",{"italic":8549},[8550],{"#text":927},{"sub":8552},[8553],{"#text":2926},{"#text":8555}," dominates over the first 4–5 min under ",{"italic":8557},[8558],{"#text":883},{"sub":8560},[8561],{"#text":887},{"#text":2936},{"xref":8564,":@":8568},[8565],{"bold":8566},[8567],{"#text":7230},{"@_ref-type":4036,"@_rid":7232},{"#text":1417},{"xref":8571,":@":8575},[8572],{"bold":8573},[8574],{"#text":7266},{"@_ref-type":1406,"@_rid":1407},{"#text":8577},"), which was longer than those reported for soybean before (",{"xref":8579,":@":8582},[8580],{"#text":8581},"Sassenrath-Cole and Pearcy, 1992",{"@_ref-type":984,"@_rid":8583},"B29",{"#text":987},{"xref":8586,":@":8588},[8587],{"#text":8494},{"@_ref-type":984,"@_rid":8496},{"#text":8590},"). Crop plants grown under controlled environments may have higher RuBP concentration and/or higher activation rate of RuBP regeneration in comparison with plants growing within tropical forests. Decreased ETR",{"sub":8592},[8593],{"#text":6080},{"#text":4131},{"italic":8596},[8597],{"#text":883},{"sub":8599},[8600],{"#text":905},{"#text":8602}," also indicated that accelerated induction of ETR was related to faster photosynthetic induction at the early stage under ",{"italic":8604},[8605],{"#text":883},{"sub":8607},[8608],{"#text":905},{"#text":8610},". Constant temperatures strongly affect RuBP regeneration during photosynthetic induction process (",{"xref":8612,":@":8614},[8613],{"#text":1101},{"@_ref-type":984,"@_rid":1103},{"#text":8616},"). Thus, accelerated induction of ETR II is expected to benefit faster relaxation of limitation through RuBP regeneration process.",{"#text":805},{"p":8619},[8620,8622,8625,8628,8630,8634,8636,8639,8642,8643,8646,8649,8651,8654,8657,8658,8664,8666,8669,8672,8673,8676,8679,8681,8684,8687,8689,8692,8695,8696,8699,8702,8704,8710,8711,8715,8717,8720,8723],{"#text":8621},"An increase in leaf temperature will result in increases in VPD in natural environment. Changes in VPD will affect photosynthetic induction by itself. For example, an increase in VPD reduced ",{"italic":8623},[8624],{"#text":1283},{"sub":8626},[8627],{"#text":1287},{"#text":8629}," and thus increased diffusional limitation (",{"xref":8631,":@":8633},[8632],{"#text":1101},{"@_ref-type":984,"@_rid":1103},{"#text":8635},"). On the other hand, when VPD was held constant, ",{"italic":8637},[8638],{"#text":1283},{"sub":8640},[8641],{"#text":1287},{"#text":1417},{"italic":8644},[8645],{"#text":1320},{"sub":8647},[8648],{"#text":1324},{"#text":8650}," would increase with increasing ",{"italic":8652},[8653],{"#text":883},{"sub":8655},[8656],{"#text":1036},{"#text":2936},{"xref":8659,":@":8662},[8660],{"#text":8661},"Urban et al., 2017",{"@_ref-type":984,"@_rid":8663},"B45",{"#text":8665},"). In our study, if we assume that ",{"italic":8667},[8668],{"#text":1283},{"sub":8670},[8671],{"#text":1287},{"#text":1417},{"italic":8674},[8675],{"#text":1320},{"sub":8677},[8678],{"#text":1324},{"#text":8680}," should remain the same as those reached under ",{"italic":8682},[8683],{"#text":883},{"sub":8685},[8686],{"#text":887},{"#text":8688},", then ",{"italic":8690},[8691],{"#text":927},{"sub":8693},[8694],{"#text":2743},{"#text":4131},{"italic":8697},[8698],{"#text":883},{"sub":8700},[8701],{"#text":905},{"#text":8703}," would increase by 16% on average. If we focus on the early-stage of induction, then effects of changes in VPD can be neglected since stomatal opening and photosynthetic induction didn’t change much by VPD at this stage (",{"xref":8705,":@":8708},[8706],{"#text":8707},"Tinoco-Ojanguren and Pearcy, 1993",{"@_ref-type":984,"@_rid":8709},"B41",{"#text":987},{"xref":8712,":@":8714},[8713],{"#text":1101},{"@_ref-type":984,"@_rid":1103},{"#text":8716},"). Therefore, concurrent increases in VPD with rising ",{"italic":8718},[8719],{"#text":883},{"sub":8721},[8722],{"#text":1036},{"#text":8724}," will not significantly change our current conclusion in this study.",{"#text":805},{"p":8727},[8728,8730,8733,8736,8738,8741,8744,8746,8749,8752,8754,8757,8760,8762,8765,8768,8769,8776,8778,8785,8787,8793,8794,8800,8801,8807,8809,8812],{"#text":8729},"The overshoots during photosynthetic induction under ",{"italic":8731},[8732],{"#text":883},{"sub":8734},[8735],{"#text":905},{"#text":8737}," may be due to inhibition of some physiological processes by high VPD and ",{"italic":8739},[8740],{"#text":883},{"sub":8742},[8743],{"#text":1036},{"#text":8745},". At the early-stage of induction when VPD and ",{"italic":8747},[8748],{"#text":883},{"sub":8750},[8751],{"#text":1036},{"#text":8753}," were not so high, Rubisco was activated and stomata gradually opened. As VPD and ",{"italic":8755},[8756],{"#text":883},{"sub":8758},[8759],{"#text":1036},{"#text":8761}," rose over a critical point, ",{"italic":8763},[8764],{"#text":1283},{"sub":8766},[8767],{"#text":1287},{"#text":2936},{"xref":8770,":@":8775},[8771],{"bold":8772},[8773],{"#text":8774},"Figures 1E–H",{"@_ref-type":4036,"@_rid":4037},{"#text":8777},"), ETR II (",{"xref":8779,":@":8784},[8780],{"bold":8781},[8782],{"#text":8783},"Figures 2A–D",{"@_ref-type":4036,"@_rid":6121},{"#text":8786},"), and possibly activation state of Rubisco (",{"xref":8788,":@":8791},[8789],{"#text":8790},"Yamori et al., 2006",{"@_ref-type":984,"@_rid":8792},"B53",{"#text":987},{"xref":8795,":@":8798},[8796],{"#text":8797},"Scafaro et al., 2016",{"@_ref-type":984,"@_rid":8799},"B30",{"#text":987},{"xref":8802,":@":8805},[8803],{"#text":8804},"Busch and Sage, 2017",{"@_ref-type":984,"@_rid":8806},"B4",{"#text":8808},") decreased and thus ",{"italic":8810},[8811],{"#text":927},{"#text":8813}," decreased. Nonetheless, the overshoots need to be clarified in the future.",{"#text":963},{"@_id":8816},"s4_2",{"#text":963},{"sec":8819,":@":9121},[8820,8821,8825,8826,8943,8944,9120],{"#text":805},{"title":8822},[8823],{"#text":8824},"Photosynthetic Limitation Analysis",{"#text":805},{"p":8827},[8828,8830,8833,8836,8837,8840,8843,8844,8850,8852,8855,8857,8863,8865,8868,8870,8873,8876,8878,8881,8884,8885,8888,8890,8893,8895,8901,8902,8908,8909,8915,8917,8920,8921,8927,8928,8934,8935,8941],{"#text":8829},"As discussed above, we determined the limiting process imposed on photosynthetic induction by comparing ",{"italic":8831},[8832],{"#text":927},{"sub":8834},[8835],{"#text":2943},{"#text":1417},{"italic":8838},[8839],{"#text":927},{"sub":8841},[8842],{"#text":2926},{"#text":2672},{"xref":8845,":@":8848},[8846],{"#text":8847},"Farquhar et al. (1980)",{"@_ref-type":984,"@_rid":8849},"B13",{"#text":8851},". The classic photosynthetic limitation analysis defines photosynthetic limitation as a reduction in actual transient ",{"italic":8853},[8854],{"#text":927},{"#text":8856}," compared with that estimated if biochemical or diffusional limitation was removed in one step. On the contrary, a stepwise method, which compares previous and subsequent photosynthesis state, produces smaller error than the one-step method, especially when time intervals between two states are small enough (",{"xref":8858,":@":8861},[8859],{"#text":8860},"Deans et al., 2019",{"@_ref-type":984,"@_rid":8862},"B10",{"#text":8864},"). The limitation analysis developed in this study is a stepwise method. Dynamic ",{"italic":8866},[8867],{"#text":927},{"#text":8869},"-",{"italic":8871},[8872],{"#text":1320},{"sub":8874},[8875],{"#text":1324},{"#text":8877}," analyses use high time-resolution dynamics of ",{"italic":8879},[8880],{"#text":2478},{"sub":8882},[8883],{"#text":2943},{"#text":1417},{"italic":8886},[8887],{"#text":2514},{"#text":8889}," by constructing induction curves at a wide range of different CO",{"sub":8891},[8892],{"#text":877},{"#text":8894}," concentrations (",{"xref":8896,":@":8899},[8897],{"#text":8898},"Soleh et al., 2016",{"@_ref-type":984,"@_rid":8900},"B35",{"#text":987},{"xref":8903,":@":8906},[8904],{"#text":8905},"Taylor and Long, 2017",{"@_ref-type":984,"@_rid":8907},"B39",{"#text":987},{"xref":8910,":@":8913},[8911],{"#text":8912},"Salter et al., 2019",{"@_ref-type":984,"@_rid":8914},"B28",{"#text":8916},"). This method is time-consuming and risky due to the dependency of Rubisco activation state on CO",{"sub":8918},[8919],{"#text":877},{"#text":1316},{"xref":8922,":@":8925},[8923],{"#text":8924},"Mott and Woodrow, 1993",{"@_ref-type":984,"@_rid":8926},"B22",{"#text":987},{"xref":8929,":@":8932},[8930],{"#text":8931},"Woodrow et al., 1996",{"@_ref-type":984,"@_rid":8933},"B52",{"#text":987},{"xref":8936,":@":8939},[8937],{"#text":8938},"Tomimatsu et al., 2019",{"@_ref-type":984,"@_rid":8940},"B43",{"#text":8942},"). Our method provides a compromise between convenience and accuracy and can be promoted with higher time-resolution fluorescence signals for both PSI and PSII.",{"#text":805},{"p":8945},[8946,8948,8951,8954,8956,8962,8964,8967,8970,8972,8975,8978,8980,8983,8985,8988,8991,8992,8995,8998,9000,9003,9006,9008,9011,9014,9016,9019,9022,9023,9026,9029,9031,9034,9037,9039,9045,9046,9052,9053,9059,9061,9065,9067,9070,9073,9075,9078,9081,9083,9089,9091,9094,9096,9099,9102,9104,9107,9110,9112,9115,9118],{"#text":8947},"Our observations showed that ",{"italic":8949},[8950],{"#text":883},{"sub":8952},[8953],{"#text":1036},{"#text":8955}," changed by \u003C0.2°C/s for the first min and \u003C0.05°C/s for the rest of induction (",{"xref":8957,":@":8961},[8958],{"bold":8959},[8960],{"#text":4034},{"@_ref-type":4036,"@_rid":4037},{"#text":8963},"). Such changes in ",{"italic":8965},[8966],{"#text":883},{"sub":8968},[8969],{"#text":1036},{"#text":8971}," should result in small changes in the steady-state ",{"italic":8973},[8974],{"#text":2375},{"sub":8976},[8977],{"#text":2379},{"#text":8979}," and Г",{"sup":8981},[8982],{"#text":2609},{"#text":8984},". Thus, assuming instantaneous response of both parameters imposed little influence (\u003C0.1%) on estimated ",{"italic":8986},[8987],{"#text":927},{"sub":8989},[8990],{"#text":2943},{"#text":945},{"italic":8993},[8994],{"#text":927},{"sub":8996},[8997],{"#text":2926},{"#text":8999},". The effect of a time lag in ",{"italic":9001},[9002],{"#text":2500},{"sub":9004},[9005],{"#text":2505},{"#text":9007}," response is also limited. If ",{"italic":9009},[9010],{"#text":2500},{"sub":9012},[9013],{"#text":2505},{"#text":9015}," changes by 50% of difference between two consecutive steady-states, ",{"italic":9017},[9018],{"#text":927},{"sub":9020},[9021],{"#text":2943},{"#text":4131},{"italic":9024},[9025],{"#text":883},{"sub":9027},[9028],{"#text":905},{"#text":9030}," changes by less than 5%, in comparison with that assuming instantaneous response of ",{"italic":9032},[9033],{"#text":2500},{"sub":9035},[9036],{"#text":2505},{"#text":9038},". A decrease in leaf absorptance and/or fraction of absorbed light allocation to PSII is likely to occur when a shaded leaf is exposed to high light for long (",{"xref":9040,":@":9043},[9041],{"#text":9042},"Davis et al., 2011",{"@_ref-type":984,"@_rid":9044},"B8",{"#text":987},{"xref":9047,":@":9050},[9048],{"#text":9049},"Dutta et al., 2015",{"@_ref-type":984,"@_rid":9051},"B12",{"#text":987},{"xref":9054,":@":9057},[9055],{"#text":9056},"Mekala et al., 2015",{"@_ref-type":984,"@_rid":9058},"B20",{"#text":9060},"). A survey from 24 species indicates that leaf absorptance of PAR decreased by ~5% after 2 h exposure to high light (",{"xref":9062,":@":9064},[9063],{"#text":9042},{"@_ref-type":984,"@_rid":9044},{"#text":9066},"), which alone may lead to an overestimation of ",{"italic":9068},[9069],{"#text":927},{"sub":9071},[9072],{"#text":2926},{"#text":9074}," by ~5% and hence underestimation of ",{"italic":9076},[9077],{"#text":927},{"sub":9079},[9080],{"#text":2926},{"#text":9082}," limitation. Simulation from ",{"xref":9084,":@":9087},[9085],{"#text":9086},"Morales et al. (2018)",{"@_ref-type":984,"@_rid":9088},"B21",{"#text":9090}," also indicate small influences on ",{"italic":9092},[9093],{"#text":927},{"#text":9095}," from changes in leaf absorptance. If allocation fraction should be 0.45 from the very beginning of induction, then ",{"italic":9097},[9098],{"#text":927},{"sub":9100},[9101],{"#text":2926},{"#text":9103}," decreased by ~10%. This would increase the duration of ",{"italic":9105},[9106],{"#text":927},{"sub":9108},[9109],{"#text":2926},{"#text":9111}," limitation, thus the dominant role of ",{"italic":9113},[9114],{"#text":927},{"sub":9116},[9117],{"#text":2926},{"#text":9119}," over the early-stage of induction still holds.",{"#text":963},{"@_id":9122},"s4_3",{"#text":963},{"sec":9125,":@":9256},[9126,9127,9131,9132,9177,9178,9202,9203,9255],{"#text":805},{"title":9128},[9129],{"#text":9130},"Ecological Consequences of Changing Leaf Temperature With PAR",{"#text":805},{"p":9133},[9134,9136,9141,9143,9146,9148,9151,9154,9156,9162,9164,9168,9169,9175],{"#text":9135},"Concurrent change of leaf temperature with PAR may play an important role in leaf carbon uptake and energy balance under temporally variable light environments. ",{"xref":9137,":@":9140},[9138],{"#text":9139},"Leakey et al. (2003)",{"@_ref-type":984,"@_rid":1066},{"#text":9142}," reported a decrease in ICG in ",{"italic":9144},[9145],{"#text":1688},{"#text":9147}," seedlings at elevated constant temperature. In this study, we demonstrate that leaf carbon gain is enhanced within the first several min under ",{"italic":9149},[9150],{"#text":883},{"sub":9152},[9153],{"#text":905},{"#text":9155},", although photosynthetic rate was depressed at the steady-state under 40°C (",{"xref":9157,":@":9161},[9158],{"bold":9159},[9160],{"#text":4076},{"@_ref-type":4078,"@_rid":4079},{"#text":9163},"). Since most sunflecks occurring under dense forest canopies last only a few min (",{"xref":9165,":@":9167},[9166],{"#text":982},{"@_ref-type":984,"@_rid":985},{"#text":987},{"xref":9170,":@":9173},[9171],{"#text":9172},"Chazdon and Pearcy, 1986b",{"@_ref-type":984,"@_rid":9174},"B6",{"#text":9176},"), the acceleration of photosynthetic rate accompanied with the increase in leaf temperature at the early stage of the induction suggests that short sunflecks may contribute more leaf carbon gain than previously estimated under constant temperature.",{"#text":805},{"p":9179},[9180,9182,9188,9189,9195,9196,9200],{"#text":9181},"Moreover, it is still debated whether shade-tolerant species can use sunflecks more efficiently than shade-intolerant species (",{"xref":9183,":@":9186},[9184],{"#text":9185},"Naumburg and Ellsworth, 2000",{"@_ref-type":984,"@_rid":9187},"B23",{"#text":987},{"xref":9190,":@":9193},[9191],{"#text":9192},"Rijkers et al., 2000",{"@_ref-type":984,"@_rid":9194},"B27",{"#text":987},{"xref":9197,":@":9199},[9198],{"#text":8494},{"@_ref-type":984,"@_rid":8496},{"#text":9201},"). However, the argument is based on the knowledge obtained only under single constant temperature. When taking variation of leaf temperature into account, more leaf carbon gain may be achieved for shade-tolerant species because these species showed higher acceleration of photosynthetic rate than the shade-intolerant species under the changing leaf temperature in this study.",{"#text":805},{"p":9204},[9205,9207,9210,9213,9215,9221,9222,9226,9227,9231,9233,9236,9239,9240,9243,9246,9247,9253],{"#text":9206},"ecent studies suggest that shade-intolerant species from tropical regions have higher photosynthetic temperature optimum, lower ",{"italic":9208},[9209],{"#text":883},{"sub":9211},[9212],{"#text":1036},{"#text":9214},", and a wider temperature range for photosynthesis (",{"xref":9216,":@":9219},[9217],{"#text":9218},"Cheesman and Winter, 2013",{"@_ref-type":984,"@_rid":9220},"B7",{"#text":987},{"xref":9223,":@":9225},[9224],{"#text":1123},{"@_ref-type":984,"@_rid":1125},{"#text":987},{"xref":9228,":@":9230},[9229],{"#text":1130},{"@_ref-type":984,"@_rid":1132},{"#text":9232},") and thus seem more competitive than shade-tolerant species in a warming world. A less strong reduction in ICG found in the shade-tolerant species under ",{"italic":9234},[9235],{"#text":883},{"sub":9237},[9238],{"#text":905},{"#text":1417},{"italic":9241},[9242],{"#text":883},{"sub":9244},[9245],{"#text":896},{"#text":2936},{"xref":9248,":@":9252},[9249],{"bold":9250},[9251],{"#text":7669},{"@_ref-type":4036,"@_rid":7671},{"#text":9254},"), however, provides some contrasting evidence. Detailed assessments on photosynthetic response and energy balance under dynamic environments, particularly under changing light and temperature conditions, are urgently needed to understand the effect of climate change on plants in tropical forests.",{"#text":963},{"@_id":9257},"s4_4",{"#text":966},{"@_id":9260,"@_sec-type":9261},"s4","discussion",{"#text":966},{"sec":9264,":@":9276,"anchorId":9277},[9265,9266,9270,9271,9275],{"#text":963},{"title":9267},[9268],{"#text":9269},"Conclusion",{"#text":963},{"p":9272},[9273],{"#text":9274},"We provide the first evidence that increase in leaf temperature, associated with increase in light, accelerates photosynthetic rate at the early stage of induction process. We further demonstrated that the acceleration is likely to be mainly due to accelerated induction of ETR II. These results extend our understanding of dynamic photosynthesis to cover the effects of concurrent changes in leaf temperature and light. However, there are a number of limitations in this preliminary study, and further studies are needed to understand physiological controls of the concurrent changes, particularly in relation to leaf energy budget.",{"#text":966},{"@_id":9277},"s5",{"#text":966},{"sec":9280,":@":9292},[9281,9282,9286,9287,9291],{"#text":963},{"title":9283},[9284],{"#text":9285},"Data Availability Statement",{"#text":963},{"p":9288},[9289],{"#text":9290},"The raw data supporting the conclusions of this article will be made available by the authors, without undue reservation.",{"#text":966},{"@_id":9293},"s6",{"#text":966},{"sec":9296,":@":9308},[9297,9298,9302,9303,9307],{"#text":963},{"title":9299},[9300],{"#text":9301},"Author Contributions",{"#text":963},{"p":9304},[9305],{"#text":9306},"H-XK and Y-HT contributed to conception and design of the study. H-XK performed the experiments and the statistical analysis. H-XK wrote the manuscript. X-GZ, WY, and Y-HT provided editorial and scientific advice. All authors contributed to the article and approved the submitted version.",{"#text":966},{"@_id":9309},"s7",{"#text":966},{"sec":9312,":@":9324,"anchorId":9325},[9313,9314,9318,9319,9323],{"#text":963},{"title":9315},[9316],{"#text":9317},"Funding",{"#text":963},{"p":9320},[9321],{"#text":9322},"This study was funded by the Key Research of Plant Functional Ecology Program of Peking University (no. 7101302307). This work was supported in part by JSPS KAKENHI (grant numbers JP16H06552, JP18H02185 and JP18KK0170 to W.Y).",{"#text":966},{"@_id":9325},"s8",{"#text":966},{"sec":9328,":@":9340},[9329,9330,9334,9335,9339],{"#text":963},{"title":9331},[9332],{"#text":9333},"Conflict of Interest",{"#text":963},{"p":9336},[9337],{"#text":9338},"The authors declare that the research was conducted in the absence of any commercial or financial relationships that could be construed as a potential conflict of interest.",{"#text":966},{"@_id":9341},"s9",{"#text":9343},"\n  ",[],[9346,9358,9370,9384,9397],{"title":9347,"order":403,"content":9348},"Data availability statement",[9349,9350,9353,9354,9357],{"#text":963},{"title":9351},[9352],{"#text":9285},{"#text":963},{"p":9355},[9356],{"#text":9290},{"#text":966},{"title":9359,"order":777,"content":9360},"Author contributions",[9361,9362,9365,9366,9369],{"#text":963},{"title":9363},[9364],{"#text":9301},{"#text":963},{"p":9367},[9368],{"#text":9306},{"#text":966},{"title":9371,"order":9372,"content":9373},"Acknowledgments",6,[9374,9375,9378,9379,9383],{"#text":963},{"title":9376},[9377],{"#text":9371},{"#text":963},{"p":9380},[9381],{"#text":9382},"We thank Kouki Hikosaka for his constructive comments and stimulating discussion. We thank Azizi Ripin for identifying plant species. Our thanks are also due to Yao Tze-Leong and other staff at the Pasoh Forest Reserve for their generous help.",{"#text":966},{"title":9385,"order":9386,"content":9387},"Conflict of interest",8,[9388,9389,9392,9393,9396],{"#text":963},{"title":9390},[9391],{"#text":9333},{"#text":963},{"p":9394},[9395],{"#text":9338},{"#text":966},{"title":9398,"order":9399,"content":9400},"Supplementary material",14,[9401,9402,9406,9407,9416,9417,9422,9423,9428,9429,9434,9435,9440,9441,9446,9447,9452],{"#text":963},{"title":9403},[9404],{"#text":9405},"Supplementary Material",{"#text":963},{"p":9408},[9409,9411],{"#text":9410},"The Supplementary Material for this article can be found online at: ",{"ext-link":9412,":@":9415},[9413],{"#text":9414},"https://www.frontiersin.org/articles/10.3389/fpls.2020.01216/full#supplementary-material",{"@_ext-link-type":847,"@_xmlns:xlink":4311,"@_xlink:href":9414},{"#text":963},{"supplementary-material":9418,":@":9419},[],{"@_xlink:href":9420,"@_id":1407,"@_mimetype":9421},"Table_1.docx","application/vnd.openxmlformats-officedocument.wordprocessingml.document",{"#text":963},{"supplementary-material":9424,":@":9425},[],{"@_xlink:href":9426,"@_id":9427,"@_mimetype":9421},"Table_2.docx","SM2",{"#text":963},{"supplementary-material":9430,":@":9431},[],{"@_xlink:href":9432,"@_id":9433,"@_mimetype":9421},"Table_3.docx","SM3",{"#text":963},{"supplementary-material":9436,":@":9437},[],{"@_xlink:href":9438,"@_id":9439,"@_mimetype":9421},"Table_4.docx","SM4",{"#text":963},{"supplementary-material":9442,":@":9443},[],{"@_xlink:href":9444,"@_id":9445,"@_mimetype":9421},"Table_5.docx","SM5",{"#text":963},{"supplementary-material":9448,":@":9449},[],{"@_xlink:href":9450,"@_id":9451,"@_mimetype":9421},"Table_6.docx","SM6",{"#text":966},[9454],{"title":9455,"id":9456,"references":9457},"References","h9",[9458,9563,9685,9763,9856,9935,10007,10096,10207,10351,10445,10539,10679,10777,10921,11057,11179,11321,11413,11502,11625,11766,11853,11933,12003,12063,12107,12215,12340,12421,12565,12640,12716,12792,12882,13026,13135,13337,13465,13536,13655,13735,13819,13946,14051,14167,14306,14383,14462,14598,14701,14775,14862,149