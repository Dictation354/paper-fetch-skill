"name":725,"content":745},"citation_author_3","Tang, Yan-Hong ",{"hid":747,"name":729,"content":730},"citation_author_institution_3",{"hid":749,"name":749,"content":750},"dc.identifier","doi:10.3389/fpls.2020.01216",[752,755,758,760],{"src":753,"body":13,"type":754,"async":13},"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=es6","text/javascript",{"innerHTML":756,"type":757},"MathJax.Hub.Config({\"CommonHTML\":{linebreaks:{automatic:true,width:\"container\"}}});","text/x-mathjax-config",{"src":759,"body":13,"type":754,"async":13},"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-MML-AM_CHTML",{"src":761,"body":13,"type":754,"async":13},"https://crossmark-cdn.crossref.org/widget/v2.0/widget.js",{"journal":763,"doi":516,"articleType":531,"title":765,"authors":767,"onBehalfOf":19,"affiliations":783,"authorNotes":793,"publicationDate":827,"acceptedDate":828,"receivedDate":829,"correctedDate":19,"retractedDate":19,"volume":617,"elocationId":830,"permissions":831,"keywords":851,"relatedArticles":867,"abstractContent":868,"bodyContent":964,"appendixContent":9344,"statements":9345,"referenceLists":9453,"references":15240,"otherBackSections":20403,"figures":20404,"toc":23406,"correspondingAuthors":23420},{"title":126,"abbreviation":605,"issn":606,"publisherName":764},"Frontiers Media S.A.",[766],{"#text":517},[768,771,775,779],{"surname":545,"givenNames":544,"suffix":19,"affiliationsIndexes":769,"isCorresponding":378,"equalContrib":378,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":770,"onBehalfOf":19},[403],"https://loop.frontiersin.org/people/939418",{"surname":554,"givenNames":553,"suffix":19,"affiliationsIndexes":772,"isCorresponding":378,"equalContrib":378,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":774,"onBehalfOf":19},[773],2,"https://loop.frontiersin.org/people/13067",{"surname":562,"givenNames":561,"suffix":19,"affiliationsIndexes":776,"isCorresponding":378,"equalContrib":378,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":778,"onBehalfOf":19},[777],3,"https://loop.frontiersin.org/people/145293",{"surname":571,"givenNames":570,"suffix":19,"affiliationsIndexes":780,"isCorresponding":378,"equalContrib":378,"hierarchySymbol":781,"footnoteSymbol":19,"loopUrl":782,"onBehalfOf":19},[403],"\n            *\n          ","https://loop.frontiersin.org/people/1051849",[784,787,790],{"index":403,"baseText":19,"institution":549,"country":550,"address":785,"textContent":786},"Beijing","Institute of Ecology, College of Urban and Environmental Sciences and Key Laboratory for Earth Surface Processes of Ministry of Education, Peking University, Beijing, China",{"index":773,"baseText":19,"institution":558,"country":550,"address":788,"textContent":789},"Shanghai","Center of Excellence for Molecular Plant Sciences and State Key Laboratory of Plant Molecular Genetics, Chinese Academy of Sciences, Shanghai, China",{"index":777,"baseText":19,"institution":566,"country":567,"address":791,"textContent":792},"Tokyo","Institute for Sustainable Agro-Ecosystem Services, Graduate School of Agricultural and Life Sciences, The University of Tokyo, Tokyo, Japan",{"editedBy":794,"editedByContent":797,"reviewedBy":806,"reviewedByContent":809,"approvedBy":816,"approvedByContent":817,"correspondence":818,"equalContribution":819,"presentAddress":19,"other":820},[795],{"textContent":796},"Edited by: Jeremy Harbinson, Wageningen University and Research, Netherlands",[798,800,804],{"#text":799},"\n          ",{"p":801},[802],{"#text":803}," Jeremy Harbinson, Wageningen University and Research, Netherlands",{"#text":805},"\n        ",[807],{"textContent":808},"Reviewed by: Elias Kaiser, Wageningen University and Research, Netherlands; Tao Li, Institute of Environment and Sustainable Development in Agriculture (CAAS), China",[810,811,815],{"#text":799},{"p":812},[813],{"#text":814}," Elias Kaiser, Wageningen University and Research, Netherlands; Tao Li, Institute of Environment and Sustainable Development in Agriculture (CAAS), China",{"#text":805},[],[],"\n          *Correspondence: Yan-Hong Tang, dGFuZ3loQHBrdS5lZHUuY24=\n        ",[],[821,822,826],{"#text":799},{"p":823},[824],{"#text":825},"This article was submitted to Plant Abiotic Stress, a section of the journal Frontiers in Plant Science",{"#text":805},"2020-08-07","2020-07-27","2020-06-04",1216,{"copyrightStatement":832,"copyrightYear":833,"copyrightHolder":834,"licenseUrl":835,"licenseText":836},"Copyright © 2020 Kang, Zhu, Yamori and Tang",2020,"Kang, Zhu, Yamori and Tang","http://creativecommons.org/licenses/by/4.0/",[837,838,850],{"#text":799},{"p":839},[840,842,848],{"#text":841},"This is an open-access article distributed under the terms of the ",{"ext-link":843,":@":846},[844],{"#text":845},"Creative Commons Attribution License (CC BY)",{"@_ext-link-type":847,"@_xlink:href":835},"uri",{"#text":849},". The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.",{"#text":805},[852,855,858,860,862,865],[853],{"#text":854},"dynamic photosynthesis",[856],{"#text":857},"photosynthetic induction",[859],{"#text":537},[861],{"#text":538},[863],{"#text":864},"sunflecks",[866],{"#text":540},[],[869,870,962],{"#text":805},{"p":871},[872,874,878,880,884,888,890,893,897,899,902,906,908,911,914,916,919,922,924,928,930,933,936,938,941,944,946,949,952,954,957,960],{"#text":873},"Leaf temperature changes with incident light intensity, but it is unclear how the concurrent changes influence leaf photosynthesis. We examined the time courses of CO",{"sub":875},[876],{"#text":877},"2",{"#text":879}," gas exchanges and chlorophyll fluorescence of seedling leaves in four tropical tree species in response to lightflecks under three different temperature conditions. The three conditions were two constant temperatures at 30°C (",{"italic":881},[882],{"#text":883},"T",{"sub":885},[886],{"#text":887},"30",{"#text":889},") and 40°C (",{"italic":891},[892],{"#text":883},{"sub":894},[895],{"#text":896},"40",{"#text":898},"), and a simulated gradually changing temperature from 30 to 40°C (",{"italic":900},[901],{"#text":883},{"sub":903},[904],{"#text":905},"dyn",{"#text":907},"). The time required to reach 50% of the full photosynthetic induction under ",{"italic":909},[910],{"#text":883},{"sub":912},[913],{"#text":896},{"#text":915}," was similar to, or even larger than, that under ",{"italic":917},[918],{"#text":883},{"sub":920},[921],{"#text":887},{"#text":923},". However, the induction of assimilation rate (",{"italic":925},[926],{"#text":927},"A",{"#text":929},") and electron transport rate of photosystem II (ETR II) and Rubisco activation process were generally accelerated under ",{"italic":931},[932],{"#text":883},{"sub":934},[935],{"#text":905},{"#text":937}," compared to those at either ",{"italic":939},[940],{"#text":883},{"sub":942},[943],{"#text":887},{"#text":945}," or ",{"italic":947},[948],{"#text":883},{"sub":950},[951],{"#text":896},{"#text":953},". The acceleration in photosynthetic induction under ",{"italic":955},[956],{"#text":883},{"sub":958},[959],{"#text":905},{"#text":961}," was significantly greater in the shade-tolerant species than in the shade-intolerant species. A modified photosynthetic limitation analysis indicated that the acceleration was likely to be mainly due to ETR II at the early stage of photosynthetic induction. The study suggests that concurrent increases in leaf temperature with light may increase leaf carbon gain under highly fluctuating light in tropical tree seedlings, particularly in shade-tolerant species.",{"#text":963},"\n      ",[965,967,1151,1152,4008,4009,8364,8365,9262,9263,9278,9279,9294,9295,9310,9311,9326,9327,9342],{"#text":966},"\n    ",{"sec":968,":@":1148,"anchorId":1149},[969,970,974,975,1025,1026,1142,1143,1147],{"#text":963},{"title":971},[972],{"#text":973},"Introduction",{"#text":963},{"p":976},[977,979,986,988,994,996,1002,1003,1009,1010,1016,1017,1023],{"#text":978},"Most of our understanding on plant photosynthesis so far is almost completely based on the measurements made under so-called steady-state or temporally constant environments. However, photosynthesis in nature rarely or even never occurs under constant environments, but under fluctuating light, and changing temperature and other environmental variables. Field observations showed considerable variation in photosynthetically active radiation (PAR) at different temporal scales from seconds to days under tropical forest canopies (",{"xref":980,":@":983},[981],{"#text":982},"Pearcy, 1983",{"@_ref-type":984,"@_rid":985},"bibr","B24",{"#text":987},"; ",{"xref":989,":@":992},[990],{"#text":991},"Tang et al., 1999",{"@_ref-type":984,"@_rid":993},"B36",{"#text":995},"). Efficient utilization of temporally variable light has been considered to be critical for leaf carbon gain (",{"xref":997,":@":1000},[998],{"#text":999},"Pearcy, 1990",{"@_ref-type":984,"@_rid":1001},"B25",{"#text":987},{"xref":1004,":@":1007},[1005],{"#text":1006},"Kaiser et al., 2015",{"@_ref-type":984,"@_rid":1008},"B15",{"#text":987},{"xref":1011,":@":1014},[1012],{"#text":1013},"Tomimatsu and Tang, 2016",{"@_ref-type":984,"@_rid":1015},"B42",{"#text":987},{"xref":1018,":@":1021},[1019],{"#text":1020},"Yamori, 2016",{"@_ref-type":984,"@_rid":1022},"B56",{"#text":1024},").",{"#text":963},{"p":1027},[1028,1030,1033,1037,1038,1044,1045,1051,1053,1056,1059,1061,1067,1069,1072,1075,1077,1080,1083,1085,1091,1093,1097,1098,1104,1105,1111,1113,1119,1120,1126,1127,1133,1134,1140],{"#text":1029},"Temporal changes in PAR under forest canopies are often accompanied with changes in leaf temperature (",{"italic":1031},[1032],{"#text":883},{"sub":1034},[1035],{"#text":1036},"leaf",{"#text":987},{"xref":1039,":@":1042},[1040],{"#text":1041},"Singsaas and Sharkey, 1998",{"@_ref-type":984,"@_rid":1043},"B31",{"#text":987},{"xref":1046,":@":1049},[1047],{"#text":1048},"Wise et al., 2004",{"@_ref-type":984,"@_rid":1050},"B50",{"#text":1052},"). Changes in ",{"italic":1054},[1055],{"#text":883},{"sub":1057},[1058],{"#text":1036},{"#text":1060}," can be closely associated with changes of PAR. For example, leaf temperature increased from 32 to 39°C within several min due to sunflecks (",{"xref":1062,":@":1065},[1063],{"#text":1064},"Leakey et al., 2003",{"@_ref-type":984,"@_rid":1066},"B18",{"#text":1068},"). Despite of a limited number of observations indicating a close relationship between changes in ",{"italic":1070},[1071],{"#text":883},{"sub":1073},[1074],{"#text":1036},{"#text":1076}," and changes in light intensity, there is no detailed quantitative description, within our knowledge, for ",{"italic":1078},[1079],{"#text":883},{"sub":1081},[1082],{"#text":1036},{"#text":1084}," changes in response to a step change in light intensity. Nonetheless, such associated changes in temperature with light are expected to influence photosynthesis in nature because leaf photosynthesis is a highly temperature-dependent process (",{"xref":1086,":@":1089},[1087],{"#text":1088},"Berry and Björkman, 1980",{"@_ref-type":984,"@_rid":1090},"B3",{"#text":1092},"). Recent studies further suggest that photosynthetic induction in response to an increase in PAR varied at different constant temperatures (",{"xref":1094,":@":1096},[1095],{"#text":1064},{"@_ref-type":984,"@_rid":1066},{"#text":987},{"xref":1099,":@":1102},[1100],{"#text":1101},"Kaiser et al., 2017",{"@_ref-type":984,"@_rid":1103},"B16",{"#text":987},{"xref":1106,":@":1109},[1107],{"#text":1108},"Wachendorf and Küppers, 2017",{"@_ref-type":984,"@_rid":1110},"B47",{"#text":1112},"). Moreover, thermal responses of photosynthesis are highly species specific (",{"xref":1114,":@":1117},[1115],{"#text":1116},"Slot et al., 2016",{"@_ref-type":984,"@_rid":1118},"B34",{"#text":987},{"xref":1121,":@":1124},[1122],{"#text":1123},"Slot and Winter, 2017a",{"@_ref-type":984,"@_rid":1125},"B32",{"#text":987},{"xref":1128,":@":1131},[1129],{"#text":1130},"Slot and Winter, 2017b",{"@_ref-type":984,"@_rid":1132},"B33",{"#text":987},{"xref":1135,":@":1138},[1136],{"#text":1137},"Fauset et al., 2018",{"@_ref-type":984,"@_rid":1139},"B14",{"#text":1141},"). However, very little knowledge has been accumulated regarding concurrent changes in leaf temperature with light on dynamic photosynthesis, despite the fact that the changes may be potentially important for leaf carbon gain under fluctuating light and temperature conditions in nature.",{"#text":963},{"p":1144},[1145],{"#text":1146},"In this study, we characterized induction kinetics in four lowland tropical tree species under two constant temperatures and a simulated dynamic temperature condition, aiming to address (1) how the concurrent changes in leaf temperature with light affect the photosynthetic induction process, (2) if and how major physiological and biochemical processes contribute to the effect(s), and (3) whether there are any differences in the effect(s) between shade-tolerant and shade-intolerant tree species in tropical rain forests.",{"#text":966},{"@_id":1149,"@_sec-type":1150},"s1","intro",{"#text":966},{"sec":1153,":@":4005,"anchorId":4006},[1154,1155,1159,1160,1247,1248,1656,1657,1694,1695,3950,3951,4004],{"#text":963},{"title":1156},[1157],{"#text":1158},"Materials and Methods",{"#text":963},{"sec":1161,":@":1245},[1162,1163,1167,1168,1187,1188,1244],{"#text":805},{"title":1164},[1165],{"#text":1166},"Study Site and Plant Species",{"#text":805},{"p":1169},[1170,1172,1178,1180,1186],{"#text":1171},"The study was conducted in a lowland tropical rain forest in Pasoh Forest Reserve (2°59′N, 102°08′E), Malaysia. This is a primary Dipterocarp forest with an averaged leaf area index estimated as 6.52 in the core area of the reserve (",{"xref":1173,":@":1176},[1174],{"#text":1175},"Tani et al., 2003b",{"@_ref-type":984,"@_rid":1177},"B38",{"#text":1179},"). The annual rainfall of the normal years, i.e., no El Niño years, observed by the meteorological station within the reserve averaged 1809 mm during the period from 1983 to 1990. Most rainfall was observed during the rainy season from March to May and from October to December. Mean annual temperature at 52 m above the forest floor was 25.6°C, ranging from 22.6 to 29.9°C (",{"xref":1181,":@":1184},[1182],{"#text":1183},"Tani et al., 2003a",{"@_ref-type":984,"@_rid":1185},"B37",{"#text":1024},{"#text":805},{"p":1189},[1190,1192,1196,1198,1202,1204,1208,1210,1214,1216,1222,1224,1228,1230,1234,1236,1242],{"#text":1191},"The study species were two shade-intolerant species, ",{"italic":1193},[1194],{"#text":1195},"Croton argyratus",{"#text":1197}," Blume and ",{"italic":1199},[1200],{"#text":1201},"Shorea leprosula",{"#text":1203}," Miq., and two shade-tolerant species, ",{"italic":1205},[1206],{"#text":1207},"Neobalanocarpus heimii",{"#text":1209}," (King) Ashton and ",{"italic":1211},[1212],{"#text":1213},"Lepisanthes senegalensis",{"#text":1215}," (Poir.) Leenh, which are all native to lowland forests (",{"xref":1217,":@":1220},[1218],{"#text":1219},"Thomas et al., 2003",{"@_ref-type":984,"@_rid":1221},"B40",{"#text":1223},"). Five to six seedlings from different light regimes were selected for each species. Light regime was characterized as averaged daily light integral (DLI) of 60 days prior to the experiment (unit mol m",{"sup":1225},[1226],{"#text":1227},"-2",{"#text":1229}," d",{"sup":1231},[1232],{"#text":1233},"-1",{"#text":1235},"), which was estimated from hemispherical photographs using SOLARCALC 7.0 (",{"xref":1237,":@":1240},[1238],{"#text":1239},"Mailly et al., 2013",{"@_ref-type":984,"@_rid":1241},"B19",{"#text":1243},"). All field measurements were conducted between August and October 2018.",{"#text":963},{"@_id":1246},"s2_1",{"#text":963},{"sec":1249,":@":1654},[1250,1251,1255,1256,1502,1503,1653],{"#text":805},{"title":1252},[1253],{"#text":1254},"Leaf Gas Exchange and Chlorophyll Fluorescence",{"#text":805},{"p":1257},[1258,1260,1263,1265,1268,1270,1273,1275,1278,1280,1284,1288,1290,1293,1294,1297,1299,1302,1304,1307,1310,1312,1315,1317,1321,1325,1327,1330,1334,1336,1339,1342,1343,1346,1349,1351,1354,1357,1359,1362,1365,1367,1370,1373,1375,1378,1381,1383,1386,1389,1391,1394,1397,1399,1408,1410,1413,1416,1418,1421,1424,1426,1429,1432,1434,1441,1443,1446,1448,1451,1453,1456,1458,1461,1463,1466,1467,1470,1472,1475,1477,1480,1482,1485,1487,1490,1492,1495,1497,1500],{"#text":1259},"Photosynthetic induction responses were measured using a LI-6800 (LI-COR, Lincoln NE, USA) fitted with a LI-6800-01 fluorometer (90% red and 10% blue) on a fully expanded and healthy leaf in each selected seedling. Leaves were first acclimated to the irradiance at 50 μmol m",{"sup":1261},[1262],{"#text":1227},{"#text":1264}," s",{"sup":1266},[1267],{"#text":1233},{"#text":1269}," for at least 20 min until steady-state assimilation rate (",{"italic":1271},[1272],{"#text":927},{"#text":1274},") and stomatal conductance for H",{"sub":1276},[1277],{"#text":877},{"#text":1279},"O (",{"italic":1281},[1282],{"#text":1283},"g",{"sub":1285},[1286],{"#text":1287},"sw",{"#text":1289},") were visibly reached, after which light was raised to 1000 μmol m",{"sup":1291},[1292],{"#text":1227},{"#text":1264},{"sup":1295},[1296],{"#text":1233},{"#text":1298}," for 32 min. ",{"italic":1300},[1301],{"#text":927},{"#text":1303},", ",{"italic":1305},[1306],{"#text":1283},{"sub":1308},[1309],{"#text":1287},{"#text":1311},", and intercellular CO",{"sub":1313},[1314],{"#text":877},{"#text":1316}," concentration (",{"italic":1318},[1319],{"#text":1320},"C",{"sub":1322},[1323],{"#text":1324},"i",{"#text":1326},") were logged every second. To avoid any artefacts from correctional changes in temperature or relative humidity, temperature of the heat exchanger (",{"italic":1328},[1329],{"#text":883},{"sub":1331},[1332],{"#text":1333},"exchg",{"#text":1335},") was controlled. Photosynthetic induction was measured under three different temperature conditions, i.e., two constant temperature conditions with 30°C (",{"italic":1337},[1338],{"#text":883},{"sub":1340},[1341],{"#text":887},{"#text":889},{"italic":1344},[1345],{"#text":883},{"sub":1347},[1348],{"#text":896},{"#text":1350},"), and a simulated dynamic temperature condition (",{"italic":1352},[1353],{"#text":883},{"sub":1355},[1356],{"#text":905},{"#text":1358},"). For the two constant temperatures, ",{"italic":1360},[1361],{"#text":883},{"sub":1363},[1364],{"#text":1036},{"#text":1366}," reached a constant value around 30.7°C under ",{"italic":1368},[1369],{"#text":883},{"sub":1371},[1372],{"#text":887},{"#text":1374}," and 36.6°C under ",{"italic":1376},[1377],{"#text":883},{"sub":1379},[1380],{"#text":896},{"#text":1382}," prior to the increase in light. Under the ",{"italic":1384},[1385],{"#text":883},{"sub":1387},[1388],{"#text":905},{"#text":1390}," condition, ",{"italic":1392},[1393],{"#text":883},{"sub":1395},[1396],{"#text":1333},{"#text":1398}," was kept at 30°C before the increase in light and then set to an expected value of 40°C at the same time when light increased. The warming speed of leaf temperature was similar to our observation within the same forest (",{"xref":1400,":@":1405},[1401],{"bold":1402},[1403],{"#text":1404},"Figure S1",{"@_ref-type":1406,"@_rid":1407},"supplementary-material","SM1",{"#text":1409},"). Prior to the induction, leaf-to-air vapor-pressure deficit (VPD) was kept steady around 1 kPa under ",{"italic":1411},[1412],{"#text":883},{"sub":1414},[1415],{"#text":905},{"#text":1417}," and ",{"italic":1419},[1420],{"#text":883},{"sub":1422},[1423],{"#text":887},{"#text":1425}," and 2.3 kPa under ",{"italic":1427},[1428],{"#text":883},{"sub":1430},[1431],{"#text":896},{"#text":1433}," to mimic the natural levels at each temperature, according to our records of within-canopy microenvironments (see ",{"xref":1435,":@":1440},[1436],{"bold":1437},[1438],{"#text":1439},"Figure S2",{"@_ref-type":1406,"@_rid":1407},{"#text":1442},"). Reference CO",{"sub":1444},[1445],{"#text":877},{"#text":1447}," concentration was maintained at 400 μmol mol",{"sup":1449},[1450],{"#text":1233},{"#text":1452},". Photosynthetic CO",{"sub":1454},[1455],{"#text":877},{"#text":1457}," response curves were generated with a LI-6400XT equipped with a LI-6400-02B LED light source on the same leaves at a block temperature of 30 and 40°C. Leaves were first fully induced under 400 μmol mol",{"sup":1459},[1460],{"#text":1233},{"#text":1462}," and 1000 μmol m",{"sup":1464},[1465],{"#text":1227},{"#text":1264},{"sup":1468},[1469],{"#text":1233},{"#text":1471},". Then, the reference CO",{"sub":1473},[1474],{"#text":877},{"#text":1476}," concentration was reduced to 50 μmol mol",{"sup":1478},[1479],{"#text":1233},{"#text":1481}," in a stepwise manner, after which it returned to the starting level. When steady-state ",{"italic":1483},[1484],{"#text":927},{"#text":1486}," was again reached, the CO",{"sub":1488},[1489],{"#text":877},{"#text":1491}," concentration was increased to 1500 μmol mol",{"sup":1493},[1494],{"#text":1233},{"#text":1496}," in several steps. Flow rate was maintained at 350 μmol s",{"sup":1498},[1499],{"#text":1233},{"#text":1501},", and relative humidity was controlled at 70%, which yield a VPD similar to that reached at the end of induction.",{"#text":805},{"p":1504},[1505,1507,1510,1511,1514,1516,1519,1522,1524,1527,1528,1531,1533,1537,1541,1542,1545,1549,1551,1554,1558,1559,1562,1565,1567,1570,1573,1575,1578,1581,1582,1585,1588,1590,1593,1594,1597,1599,1603,1605,1609,1611,1617,1619,1623,1625,1629,1630,1633,1635,1638,1640,1643,1645,1651],{"#text":1506},"All measurements were repeated with the same environmental settings as the measurement of photosynthetic induction course to produce the time courses of chlorophyll fluorescence signals using the same LI-6800. Hence, we obtained two sets of induction curves, one with gas exchange only and the other with both gas exchange and chlorophyll fluorescence. Leaf samples were placed in dark for at least 2 h. Then, light was increased to 50 μmol m",{"sup":1508},[1509],{"#text":1227},{"#text":1264},{"sup":1512},[1513],{"#text":1233},{"#text":1515}," until gas exchange parameters reached steady state, which typically took 20 min, followed by 30 min of induction. However, due to weather and insufficient time, some chlorophyll fluorescence measurements under ",{"italic":1517},[1518],{"#text":883},{"sub":1520},[1521],{"#text":905},{"#text":1523}," started from a light intensity of 50 μmol m",{"sup":1525},[1526],{"#text":1227},{"#text":1264},{"sup":1529},[1530],{"#text":1233},{"#text":1532}," directly without dark adaptation. For these measurements, less time (~10 min) was required to reach steady state under low light. Gas exchange parameters were recorded every 5 s, and chlorophyll fluorescence was recorded every minute. Recorded chlorophyll fluorescence signals include ",{"italic":1534},[1535],{"#text":1536},"F",{"sub":1538},[1539],{"#text":1540},"o",{"#text":1417},{"italic":1543},[1544],{"#text":1536},{"sub":1546},[1547],{"#text":1548},"M",{"#text":1550},", if leaves were dark adapted, ",{"italic":1552},[1553],{"#text":1536},{"sub":1555},[1556],{"#text":1557},"s",{"#text":1303},{"italic":1560},[1561],{"#text":1536},{"sub":1563},[1564],{"#text":1548},{"#text":1566},"’, and ",{"italic":1568},[1569],{"#text":1536},{"sub":1571},[1572],{"#text":1540},{"#text":1574},"’ by turning off the actinic light and then applying far-red light. We used the multi-phase flash (MPF) protocol of the fluorometer for measuring ",{"italic":1576},[1577],{"#text":1536},{"sub":1579},[1580],{"#text":1548},{"#text":1417},{"italic":1583},[1584],{"#text":1536},{"sub":1586},[1587],{"#text":1548},{"#text":1589},"’. MPF settings were as factory default, including 8000 μmol m",{"sup":1591},[1592],{"#text":1227},{"#text":1264},{"sup":1595},[1596],{"#text":1233},{"#text":1598}," for flash beam intensity, 40% ramp reduction during the 2",{"sup":1600},[1601],{"#text":1602},"nd",{"#text":1604}," phase of the MPF, and 0.3 s duration of each flash phase. The quantum yields of photosystem II [",{"italic":1606},[1607],{"#text":1608},"Y",{"#text":1610},"(II)] were calculated after ",{"xref":1612,":@":1615},[1613],{"#text":1614},"Yamori et al. (2012)",{"@_ref-type":984,"@_rid":1616},"B54",{"#text":1618},". The electron transport rates of photosystem II (ETR II) were calculated using the following equation: ETR II = 0.5 × ",{"italic":1620},[1621],{"#text":1622},"α",{"#text":1624}," × ",{"italic":1626},[1627],{"#text":1628},"I",{"#text":1624},{"italic":1631},[1632],{"#text":1608},{"#text":1634},"(II), where 0.5 is the fraction of absorbed light allocated to photosystems II, ",{"italic":1636},[1637],{"#text":1622},{"#text":1639}," is leaf light absorptance (see below), and ",{"italic":1641},[1642],{"#text":1628},{"#text":1644}," is light intensity. The quantum yields of photochemical quenching based on the puddle (qP) and the lake model (qL) and non-photochemical quenching (NPQ) were calculated as described by ",{"xref":1646,":@":1649},[1647],{"#text":1648},"Kalaji et al. (2017)",{"@_ref-type":984,"@_rid":1650},"B17",{"#text":1652},". Data obtained without dark adaptation were excluded from NPQ calculation.",{"#text":963},{"@_id":1655},"s2_2",{"#text":963},{"sec":1658,":@":1692},[1659,1660,1664,1665,1691],{"#text":805},{"title":1661},[1662],{"#text":1663},"Light Absorptance",{"#text":805},{"p":1666},[1667,1669,1673,1674,1678,1679,1683,1685,1689],{"#text":1668},"Leaf light absorptance was calculated from measured reflectance and transmittance. For each species, four to six branches from seedlings other than those for photosynthesis measurements were sampled around 18:00 h, with the cut end submerged in water immediately. Samples were kept in dark and then measured within 6 h using a Maya-2000-Pro spectrometer (Ocean Optics, Dunedin, FL, USA). Four to six healthy, fully expanded leaves in each sampled branch and three to four discs per leaf were measured. Light absorptance was calculated with respect to the irradiance spectrum of the LI-6800-01 fluorometer, which was also measured with the same spectrometer. This yield leaf light absorptance of 0.88, 0.87, 0.90, and 0.92 for ",{"italic":1670},[1671],{"#text":1672},"N. heimii",{"#text":1303},{"italic":1675},[1676],{"#text":1677},"L. senegalensis",{"#text":1303},{"italic":1680},[1681],{"#text":1682},"C. argyratus",{"#text":1684},", and ",{"italic":1686},[1687],{"#text":1688},"S. leprosula",{"#text":1690},", respectively.",{"#text":963},{"@_id":1693},"s2_3",{"#text":963},{"sec":1696,":@":3948},[1697,1698,1702,1703,1795,1796,1874,1875,2058,2059,2168,2169,2200,2201,2328,2329,2345,2346,2413,2414,2577,2578,2633,2634,2688,2689,2849,2850,2946,2947,3176,3177,3405,3406,3445,3446,3637,3638,3693,3694,3857,3858,3892,3893,3947],{"#text":805},{"title":1699},[1700],{"#text":1701},"Data Analysis",{"#text":805},{"p":1704},[1705,1707,1710,1713,1715,1718,1720,1723,1725,1728,1730,1737,1741,1743,1746,1749,1751,1754,1757,1759,1762,1763,1766,1768,1771,1772,1775,1778,1779,1782,1785,1787,1794],{"#text":1706},"For those measurements made under ",{"italic":1708},[1709],{"#text":883},{"sub":1711},[1712],{"#text":905},{"#text":1714},", the time course of H",{"sub":1716},[1717],{"#text":877},{"#text":1719},"O concentration in the sample cell (H",{"sub":1721},[1722],{"#text":877},{"#text":1724},"O",{"sub":1726},[1727],{"#text":1557},{"#text":1729},") exhibited an unusually steep peak within the first minute, since the LI-6800 started to elevate ",{"italic":1731},[1732,1733],{"#text":883},{"sub":1734},[1735],{"#text":1736},"e",{"sub":1738},[1739],{"#text":1740},"xchg",{"#text":1742},". As a result, stomatal conductance doubled and ",{"italic":1744},[1745],{"#text":1320},{"sub":1747},[1748],{"#text":1324},{"#text":1750}," increased during the first minute since LED light and ",{"italic":1752},[1753],{"#text":883},{"sub":1755},[1756],{"#text":1333},{"#text":1758}," concurrently changed. After excluding the possibility of a contaminated leaf chamber by repeating the same measurement settings with a brand new LI-6800 later, we suspected that such errors were induced by the heat exchanger itself. We matched the LI-6800 only immediately before each measurement, and the differences in match adjustment factor between two consecutive measurements were small compared to the differences in water concentrations result from foliar transpiration. Thus, we proposed an empirical method to sequentially correct H",{"sub":1760},[1761],{"#text":877},{"#text":1724},{"sub":1764},[1765],{"#text":1557},{"#text":1767},", transpiration rate, ",{"italic":1769},[1770],{"#text":927},{"#text":1303},{"italic":1773},[1774],{"#text":1283},{"sub":1776},[1777],{"#text":1287},{"#text":1684},{"italic":1780},[1781],{"#text":1320},{"sub":1783},[1784],{"#text":1324},{"#text":1786}," (for detailed information, see ",{"xref":1788,":@":1793},[1789],{"bold":1790},[1791],{"#text":1792},"Supplementary File S1",{"@_ref-type":1406,"@_rid":1407},{"#text":1024},{"#text":805},{"p":1797},[1798,1800,1859,1861,1864,1866,1872],{"#text":1799},"To determine the maximum rate of increase in ",{"inline-formula":1801},[1802],{"mml:math":1803,":@":1855},[1804],{"mml:mrow":1805},[1806,1809,1813],{"mml:mi":1807},[1808],{"#text":927},{"mml:mtext":1810},[1811],{"#text":1812}," ",{"mml:mrow":1814},[1815,1819,1851],{"mml:mo":1816},[1817],{"#text":1818},"(",{"mml:mrow":1820},[1821],{"mml:msub":1822},[1823,1845],{"mml:mrow":1824},[1825],{"mml:mfrac":1826},[1827,1836],{"mml:mrow":1828},[1829,1833],{"mml:mi":1830},[1831],{"#text":1832},"d",{"mml:mi":1834},[1835],{"#text":927},{"mml:mrow":1837},[1838,1841],{"mml:mi":1839},[1840],{"#text":1832},{"mml:mi":1842},[1843],{"#text":1844},"t",{"mml:mrow":1846},[1847],{"mml:mi":1848},[1849],{"#text":1850},"max",{"mml:mo":1852},[1853],{"#text":1854},")",{"@_display":1856,"@_id":1857,"@_xmlns:mml":1858},"inline","im1","http://www.w3.org/1998/Math/MathML",{"#text":1860},", the time courses of ",{"italic":1862},[1863],{"#text":927},{"#text":1865}," during induction (gas exchange only) were fitted to the Boltzmann sigmoidal model proposed by ",{"xref":1867,":@":1870},[1868],{"#text":1869},"Drake et al. (2013)",{"@_ref-type":984,"@_rid":1871},"B11",{"#text":1873},":",{"#text":805},{"disp-formula":1876},[1877,1878,1882,1883,2057],{"#text":799},{"label":1879},[1880],{"#text":1881},"(1)",{"#text":799},{"mml:math":1884,":@":2054},[1885,1887,2053],{"#text":1886},"\n            ",{"mml:mrow":1888},[1889,1891,1894,1895,1899,1900,1903,1904,1908,1909,1913,1914,2036,2037,2040,2041,2052],{"#text":1890},"\n              ",{"mml:mi":1892},[1893],{"#text":927},{"#text":1890},{"mml:mo":1896,":@":1898},[1897],{"#text":1818},{"@_stretchy":378},{"#text":1890},{"mml:mi":1901},[1902],{"#text":1844},{"#text":1890},{"mml:mo":1905,":@":1907},[1906],{"#text":1854},{"@_stretchy":378},{"#text":1890},{"mml:mo":1910},[1911],{"#text":1912},"=",{"#text":1890},{"mml:mfrac":1915},[1916,1918,1954,1955,2035],{"#text":1917},"\n                ",{"mml:mrow":1919},[1920,1922,1936,1937,1941,1942,1953],{"#text":1921},"\n                  ",{"mml:msub":1923},[1924,1926,1930,1931,1935],{"#text":1925},"\n                    ",{"mml:mi":1927},[1928],{"#text":1929},"a",{"#text":1925},{"mml:mn":1932},[1933],{"#text":1934},"1",{"#text":1921},{"#text":1921},{"mml:mo":1938},[1939],{"#text":1940},"−",{"#text":1921},{"mml:msub":1943},[1944,1945,1948,1949,1952],{"#text":1925},{"mml:mi":1946},[1947],{"#text":1929},{"#text":1925},{"mml:mn":1950},[1951],{"#text":877},{"#text":1921},{"#text":1917},{"#text":1917},{"mml:mrow":1956},[1957,1958,1961,1962,1966,1967,2011,2012,2017,2018,2022,2023,2034],{"#text":1921},{"mml:mn":1959},[1960],{"#text":1934},{"#text":1921},{"mml:mo":1963},[1964],{"#text":1965},"+",{"#text":1921},{"mml:msup":1968},[1969,1970,1973,1974,2010],{"#text":1925},{"mml:mi":1971},[1972],{"#text":1736},{"#text":1925},{"mml:mrow":1975},[1976,1978,1982,1983,1986,1987,1990,1991,2004,2005,2009],{"#text":1977},"\n                      ",{"mml:mo":1979,":@":1981},[1980],{"#text":1818},{"@_stretchy":378},{"#text":1977},{"mml:mi":1984},[1985],{"#text":1844},{"#text":1977},{"mml:mo":1988},[1989],{"#text":1940},{"#text":1977},{"mml:msub":1992},[1993,1995,1998,1999,2003],{"#text":1994},"\n                        ",{"mml:mi":1996},[1997],{"#text":1844},{"#text":1994},{"mml:mn":2000},[2001],{"#text":2002},"0",{"#text":1977},{"#text":1977},{"mml:mo":2006,":@":2008},[2007],{"#text":1854},{"@_stretchy":378},{"#text":1925},{"#text":1921},{"#text":1921},{"mml:mo":2013,":@":2016},[2014],{"#text":2015},"/",{"@_stretchy":378},{"#text":1921},{"mml:mi":2019},[2020],{"#text":2021},"Δ",{"#text":1921},{"mml:msub":2024},[2025,2026,2029,2030,2033],{"#text":1925},{"mml:mi":2027},[2028],{"#text":1844},{"#text":1925},{"mml:mi":2031},[2032],{"#text":927},{"#text":1921},{"#text":1917},{"#text":1890},{"#text":1890},{"mml:mo":2038},[2039],{"#text":1965},{"#text":1890},{"mml:msub":2042},[2043,2044,2047,2048,2051],{"#text":1917},{"mml:mi":2045},[2046],{"#text":1929},{"#text":1917},{"mml:mn":2049},[2050],{"#text":877},{"#text":1890},{"#text":1886},{"#text":799},{"@_display":2055,"@_id":2056},"block","M1",{"#text":805},{"#text":805},{"p":2060},[2061,2063,2066,2069,2070,2073,2076,2078,2081,2084,2086,2092,2094,2097,2099,2102,2105,2107,2166],{"#text":2062},"where ",{"italic":2064},[2065],{"#text":1929},{"sub":2067},[2068],{"#text":1934},{"#text":1417},{"italic":2071},[2072],{"#text":1929},{"sub":2074},[2075],{"#text":877},{"#text":2077}," are the left and right horizontal asymptotes, respectively, ",{"italic":2079},[2080],{"#text":1844},{"sub":2082},[2083],{"#text":2002},{"#text":2085}," is the point of inflection, and Δ",{"italic":2087},[2088,2089],{"#text":1844},{"sub":2090},[2091],{"#text":927},{"#text":2093}," describes the steepness of the curve. The maximum rate of increase is the value of the derivative of Equation (1), where ",{"italic":2095},[2096],{"#text":1844},{"#text":2098}," = ",{"italic":2100},[2101],{"#text":1844},{"sub":2103},[2104],{"#text":2002},{"#text":2106},". The maximum rate of increase in ",{"inline-formula":2108},[2109],{"mml:math":2110,":@":2164},[2111],{"mml:mrow":2112},[2113,2127],{"mml:msub":2114},[2115,2118],{"mml:mi":2116},[2117],{"#text":1283},{"mml:mrow":2119},[2120,2123],{"mml:mi":2121},[2122],{"#text":1557},{"mml:mi":2124},[2125],{"#text":2126},"w",{"mml:mrow":2128},[2129,2132,2161],{"mml:mo":2130},[2131],{"#text":1818},{"mml:mrow":2133},[2134],{"mml:msub":2135},[2136,2156],{"mml:mrow":2137},[2138],{"mml:mfrac":2139},[2140,2148],{"mml:mrow":2141},[2142,2145],{"mml:mi":2143},[2144],{"#text":1832},{"mml:mi":2146},[2147],{"#text":1283},{"mml:mrow":2149},[2150,2153],{"mml:mi":2151},[2152],{"#text":1832},{"mml:mi":2154},[2155],{"#text":1844},{"mml:mrow":2157},[2158],{"mml:mi":2159},[2160],{"#text":1850},{"mml:mo":2162},[2163],{"#text":1854},{"@_display":1856,"@_id":2165},"im3",{"#text":2167}," was calculated in the same way.",{"#text":805},{"p":2170},[2171,2173,2176,2179,2180,2183,2186,2188,2191,2193,2199],{"#text":2172},"To assess if sunfleck utilization was improved or inhibited under ",{"italic":2174},[2175],{"#text":883},{"sub":2177},[2178],{"#text":905},{"#text":1417},{"italic":2181},[2182],{"#text":883},{"sub":2184},[2185],{"#text":896},{"#text":2187},", induction carbon gain (ICG) at time ",{"italic":2189},[2190],{"#text":1844},{"#text":2192}," was calculated after ",{"xref":2194,":@":2197},[2195],{"#text":2196},"Chazdon and Pearcy (1986a)",{"@_ref-type":984,"@_rid":2198},"B5",{"#text":1873},{"#text":805},{"disp-formula":2202},[2203,2204,2208,2209,2327],{"#text":799},{"label":2205},[2206],{"#text":2207},"(2)",{"#text":799},{"mml:math":2210,":@":2325},[2211,2212,2324],{"#text":1886},{"mml:mrow":2213},[2214,2215,2219,2220,2224,2225,2