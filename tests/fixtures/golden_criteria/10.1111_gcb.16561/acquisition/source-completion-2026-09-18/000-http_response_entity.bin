{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2026,9,12]],"date-time":"2026-09-12T19:56:22Z","timestamp":1789242982683,"version":"build-2803163510"},"reference-count":111,"publisher":"Wiley","issue":"6","license":[{"start":{"date-parts":[[2022,12,22]],"date-time":"2022-12-22T00:00:00Z","timestamp":1671667200000},"content-version":"vor","delay-in-days":0,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#vor"}],"funder":[{"DOI":"10.13039\/501100017534","name":"Project 333 of Jiangsu Province","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100017534","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100018594","name":"Central University Basic Research Fund of China","doi-asserted-by":"publisher","award":["B200204016"],"award-info":[{"award-number":["B200204016"]}],"id":[{"id":"10.13039\/501100018594","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100018594","name":"Central University Basic Research Fund of China","doi-asserted-by":"publisher","award":["B210203052"],"award-info":[{"award-number":["B210203052"]}],"id":[{"id":"10.13039\/501100018594","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100001809","name":"National Natural Science Foundation of China","doi-asserted-by":"publisher","award":["51979071"],"award-info":[{"award-number":["51979071"]}],"id":[{"id":"10.13039\/501100001809","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100001809","name":"National Natural Science Foundation of China","doi-asserted-by":"publisher","award":["U2240218"],"award-info":[{"award-number":["U2240218"]}],"id":[{"id":"10.13039\/501100001809","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100018538","name":"National Ten Thousand Talent Program","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100018538","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100013088","name":"Qinglan Project of Jiangsu Province of China","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100013088","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":["onlinelibrary.wiley.com"],"crossmark-restriction":true},"short-container-title":["Global Change Biology"],"published-print":{"date-parts":[[2023,3]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>\n                    Climate change alters surface water availability (WA; precipitation minus evapotranspiration,\n                    <jats:italic>P<\/jats:italic>\n                    \u2009\u2212\u2009ET) and consequently impacts agricultural production and societal water needs, leading to increasing concerns on the sustainability of water use. Although the direct effects of climate change on WA have long been recognized and assessed, indirect climate effects occurring through adjustments in terrestrial vegetation are more subtle and not yet fully quantified. To address this knowledge gap, here we investigate the interplay between climate\u2010induced changes in leaf area index (LAI) and ET and quantify its ultimate effect on WA during the period 1982\u20132016 at the global scale, using an ensemble of data\u2010driven products and land surface models. We show that ~44% of the global vegetated land has experienced a significant increase in growing season\u2010averaged LAI and climate change explains 33.5% of this greening signal. Such climate\u2010induced greening has enhanced ET of 0.051\u2009\u00b1\u20090.067\u2009mm\u2009year\n                    <jats:sup>\u22122<\/jats:sup>\n                    (mean\u2009\u00b1\u2009SD), further amplifying the ongoing increase in ET directly driven by variations in climatic factors over 36.8% of the globe, and thus exacerbating the decline in WA prominently in drylands. These findings highlight the indirect impact of positive feedbacks in the land\u2013climate system on the decline of WA, and call for an in\u2010depth evaluation of these phenomena in the design of local mitigation and adaptation plans.\n                  <\/jats:p>","DOI":"10.1111\/gcb.16561","type":"journal-article","created":{"date-parts":[[2022,12,16]],"date-time":"2022-12-16T02:36:28Z","timestamp":1671158188000},"page":"1628-1647","update-policy":"https:\/\/doi.org\/10.1002\/crossmark_policy","source":"Crossref","is-referenced-by-count":112,"title":["Climate\u2010driven vegetation greening further reduces water availability in drylands"],"prefix":"10.1111","volume":"29","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-0245-3922","authenticated-orcid":false,"given":"Zefeng","family":"Chen","sequence":"first","affiliation":[{"name":"State Key Laboratory of Hydrology\u2010Water Resources and Hydraulic Engineering Hohai University  Nanjing China"},{"name":"College of Hydrology and Water Resources Hohai University  Nanjing China"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-8258-1309","authenticated-orcid":false,"given":"Weiguang","family":"Wang","sequence":"additional","affiliation":[{"name":"State Key Laboratory of Hydrology\u2010Water Resources and Hydraulic Engineering Hohai University  Nanjing China"},{"name":"College of Hydrology and Water Resources Hohai University  Nanjing China"},{"name":"Key Laboratory of Water Big Data Technology of Ministry of Water Resources Hohai University  Nanjing China"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-2769-2591","authenticated-orcid":false,"given":"Alessandro","family":"Cescatti","sequence":"additional","affiliation":[{"name":"European Commission Joint Research Centre  Ispra Italy"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5240-1303","authenticated-orcid":false,"given":"Giovanni","family":"Forzieri","sequence":"additional","affiliation":[{"name":"Department of Civil and Environmental Engineering University of Florence  Florence Italy"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2022,12,22]]},"reference":[{"key":"e_1_2_9_2_1","doi-asserted-by":"publisher","DOI":"10.1038\/s41467\u2010022\u201028305\u20109"},{"key":"e_1_2_9_3_1","unstructured":"Allen R. Pereira L. Raes D. &Smith M.(1998).Crop evapotranspiration\u2014Guidelines for computing crop water requirements. FAO Irrigation and drainage paper 56. Food and Agriculture Organization Rome."},{"key":"e_1_2_9_4_1","doi-asserted-by":"publisher","DOI":"10.1890\/090179"},{"key":"e_1_2_9_5_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.jhydrol.2018.09.065"},{"key":"e_1_2_9_6_1","doi-asserted-by":"publisher","DOI":"10.5194\/acp\u201019\u201012361\u20102019"},{"key":"e_1_2_9_7_1","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.2123393119"},{"key":"e_1_2_9_8_1","doi-asserted-by":"publisher","DOI":"10.5194\/gmd\u20104\u2010677\u20102011"},{"key":"e_1_2_9_9_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.jag.2008.11.002"},{"key":"e_1_2_9_10_1","doi-asserted-by":"publisher","DOI":"10.1126\/science.1155121"},{"key":"e_1_2_9_11_1","doi-asserted-by":"publisher","DOI":"10.1126\/science.aam8328"},{"key":"e_1_2_9_12_1","doi-asserted-by":"publisher","DOI":"10.1111\/gcb.14451"},{"key":"e_1_2_9_13_1","doi-asserted-by":"publisher","DOI":"10.1038\/s41893\u2010019\u20100220\u20107"},{"key":"e_1_2_9_14_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.jhydrol.2020.125775"},{"key":"e_1_2_9_15_1","doi-asserted-by":"publisher","DOI":"10.5194\/essd\u201013\u20104175\u20102021"},{"key":"e_1_2_9_16_1","doi-asserted-by":"publisher","DOI":"10.1038\/nclimate1633"},{"key":"e_1_2_9_17_1","doi-asserted-by":"publisher","DOI":"10.1002\/joc.5537"},{"key":"e_1_2_9_18_1","doi-asserted-by":"publisher","DOI":"10.1038\/nclimate2941"},{"key":"e_1_2_9_19_1","doi-asserted-by":"publisher","DOI":"10.1038\/nclimate1632"},{"key":"e_1_2_9_20_1","doi-asserted-by":"publisher","DOI":"10.5194\/essd\u201010\u20101265\u20102018"},{"key":"e_1