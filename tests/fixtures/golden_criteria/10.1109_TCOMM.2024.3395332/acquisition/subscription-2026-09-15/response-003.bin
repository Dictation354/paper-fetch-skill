	xplGlobal.document.metadata={"userInfo":{"institute":false,"member":false,"individual":false,"guest":false,"subscribedContent":false,"fileCabinetContent":false,"fileCabinetUser":false,"dtrDeleteCookieOnLogout":false,"institutionalFileCabinetUser":false,"dtrCookieExpirationDays":0,"showPatentCitations":true,"showGet802Link":false,"showOpenUrlLink":false,"tracked":false,"institutionUserId":0,"delegatedAdmin":false,"desktop":false,"isInstitutionDashboardEnabled":false,"isInstitutionProfileEnabled":false,"isRoamingEnabled":false,"isDelegatedAdmin":false,"isMdl":false,"isCwg":false,"isReadAndPublish":false,"isAcademic":false,"isIel":false},"authors":[{"name":"Navya Saxena","affiliation":["Qualcomm India Private Ltd., Hyderabad, India"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/26/10721242/10511075/saxen-3395332-small.gif","p":["Navya Saxena was born in Uttar Pradesh, India. She received the B.Tech. degree in electronics and communication from Harcourt Butler Technological University and the M.Tech. (Research) degree in electrical communication engineering from the Department of ECE, IISc. She is currently with Qualcomm India Private Ltd., Hyderabad. Her research interests include index coding and their applications."]},"firstName":"Navya","lastName":"Saxena","orcid":"0009-0009-8685-6160","id":"391065105245439"},{"name":"Anjana A. Mahesh","affiliation":["Samsung Research and Development Institute, Bengaluru, India"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/26/10721242/10511075/mahes-3395332-small.gif","p":["Anjana A. Mahesh (Member, IEEE) was born in Kerala, India. She received the B.Tech. degree in electronics and communication from Kerala University and the master’s degree in telecommunication and the Ph.D. degree in electrical communication engineering from the Department of ECE, IISc. She is currently with the Samsung Research and Development Institute, Bengaluru, India. Previously, she held positions at Qualcomm India Private Ltd., Bengaluru, and Lekha Wireless Solutions, Bengaluru. Her research interests include index coding, coded caching, and their applications. She was a recipient of the Qualcomm Innovation Fellowship."]},"firstName":"Anjana A.","lastName":"Mahesh","orcid":"0000-0003-0892-3195","id":"38013396100"},{"name":"B. Sundar Rajan","affiliation":["Department of Electrical Communication Engineering, Indian Institute of Science, Bengaluru, India"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/26/10721242/10511075/rajan-3395332-small.gif","p":["B. Sundar Rajan (Life Fellow, IEEE) was born in Tamil Nadu, India. He received the B.Sc. degree in mathematics from Madras University, Madras, India, in 1979, the B.Tech. degree in electronics from Madras Institute of Technology, Madras, in 1982, and the M.Tech. and Ph.D. degrees in electrical engineering from IIT Kanpur, Kanpur, in 1984 and 1989, respectively.","He was a Faculty Member with the Department of Electrical Engineering, IIT Delhi, New Delhi, from 1990 to 1997. He has been a Professor with the Department of Electrical Communication Engineering, Indian Institute of Science, Bengaluru, since 1998. His research interests include space–time coding for MIMO channels, distributed space–time coding and cooperative communication, coding for multiple-access and relay channels, and network coding.","Dr. Rajan is a J. C. Bose National Fellow from 2016 to 2025 and a member of American Mathematical Society. He is a fellow of Indian National Academy of Engineering, Indian National Science Academy, Indian Academy of Sciences, and the National Academy of Sciences, India. He was a recipient of Prof. Rustum Choksi Award by IISc for Excellence in Research in Engineering in 2009, the IETE Pune Center’s S. V.C. Aiya Award for Telecom Education in 2004, and the Best Academic Paper Award at IEEE WCNC in 2011. He served as the Technical Program Co-Chair for the IEEE Information Theory Workshop (ITW’02), Bengaluru, in 2002. He was an Editor of IEEE Wireless Communications Letters from 2012 to 2015 and IEEE Transactions on Wireless Communications from 2007 to 2011 and an Associate Editor of Coding Theory for IEEE Transactions on Information Theory from 2008 to 2011 and from 2013 to 2015."]},"firstName":"B. Sundar","lastName":"Rajan","orcid":"0000-0002-7847-0200","id":"37283445100"}],"issn":[{"format":"Print ISSN","value":"0090-6778"},{"format":"Electronic ISSN","value":"1558-0857"}],"articleNumber":"10511075","mediaPath":"/mediastore/IEEE/content/media/26/10721242/10511075","dbTime":"1 ms","metrics":{"wosCitationCount":0,"citationCountPaper":1,"citationCountPatent":0,"totalDownloads":259},"purchaseOptions":{"showOtherFormatPricingTab":false,"showPdfFormatPricingTab":true,"pdfPricingInfoAvailable":true,"otherPricingInfoAvailable":false,"mandatoryBundle":false,"optionalBundle":false,"displayTextWhenOtherFormatPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information.","pdfPricingInfo":[{"memberPrice":"$16.00","nonMemberPrice":"$36.00","partNumber":"10511075","type":"PDF/HTML"}]},"getProgramTermsAccepted":false,"sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"displayPublicationTitle":"IEEE Transactions on Communications","abstract":"This paper studies noisy index coding problems over broadcast channels. The codewords from a chosen binary index code of length N are mapped to a <inline-formula xmlns:mml=\"http://www.w3.org/1998/Math/MathML\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <tex-math notation=\"LaTeX\">$2^{N}$ </tex-math></inline-formula>-PSK constellation before being transmitted over an AWGN channel. The receivers follow the two-step decoding process of first estimating the PSK symbol using a maximum-likelihood decoder and then performing index code decoding. After estimating the PSK symbol, there is, in general, more than one decoding strategy at a receiver, i.e., more than one linear combination of index-coded bits along with a subset of side information bits, that can be used to estimate the requested message. Thomas et al. in [“Single Uniprior Index Coding With Min-Max Probability of Error Over Fading Channels,” IEEE Transactions on Vehicular Technology, pp. 6050-6059, July 2017] showed that for binary-modulated index code transmissions, minimizing the number of transmissions used to decode a requested message is equivalent to reducing the probability of error. This paper shows that this is no longer true while employing multi-level modulations. Further, we consider the side information available to each receiver also to be noisy and derive an expression for the probability that a requested message bit is estimated erroneously at a receiver. We also show that the criterion for choosing a decoding strategy that gives the best probability of error performance at a receiver changes with the signal-to-noise ratio at which the side information is broadcast. Hence, for a given index coding problem and a chosen index code, we give an algorithm to select the best decoding strategy for the receivers. The above results are shown to be valid over fading channels also.","publicationDate":"October 2024","publicationYear":"2024","pdfPath":"/iel7/26/10721242/10511075.pdf","pdfUrl":"/stamp/stamp.jsp?tp=&arnumber=10511075","publicationTitle":"IEEE Transactions on Communications","startPage":"6102","endPage":"6115","formulaStrippedArticleTitle":"An Optimal Two-Step Decoding for PSK-Modulated Noisy Index Coding","keywords":[{"type":"IEEE Keywords","kwd":["Receivers","Indexes","Maximum likelihood decoding","Codes","Noise measurement","Servers","Phase shift keying"]},{"type":"Index Terms","kwd":["Index Coding","Two-step Decoding","Linear Combination","Error Probability","Error Performance","Fading Channel","Information Bits","Codeword","Decoding Scheme","Broadcast Channel","Simulation Results","Minimum Distance","Bit Error Rate","Modulation Scheme","Low Signal-to-noise Ratio","High Regime","Bit Error","Noise Characteristics","Code Length","Index Codes","Receiver Performance","Minimum Euclidean Distance","Noisy Channels","Perfect Channel State Information","Bit Error Rate Performance","Single Message","Noisy Information","Optimal Index","Error Floor","Decoding Function"]},{"type":"Author Keywords","kwd":["Broadcast channels","noisy index coding","side information"]}],"allowComments":false,"pubLink":"/xpl/RecentIssue.jsp?punumber=26","doiLink":"https://doi.org/10.1109/TCOMM.2024.3395332","authorNames":"Navya Saxena;Anjana A. Mahesh;B. Sundar Rajan","dateOfInsertion":"30 April 2024","articleCopyRight":"2024 IEEE","rightsLink":"http://s100.copyright.com/AppDispatchServlet?publisherName=ieee&publication=26&title=An+Optimal+Two-Step+Decoding+for+PSK-Modulated+Noisy+Index+Coding&isbn=&publicationDate=October+2024&author=Navya+Saxena&ContentID=10.1109/TCOMM.2024.3395332&orderBeanReset=true&startPage=6102&endPage=6115&volumeNum=72&issueNum=10","displayPublicationDate":"30 April 2024","issueLink":"/xpl/tocresult.jsp?isnumber=10721242&punumber=26","isGetAddressInfoCaptured":false,"isMarketingOptIn":false,"pubTopics":[{"name":"Communication, Networking and Broadcast Technologies"}],"publisher":"IEEE","isOpenAccess":false,"isEphemera":false,"isConference":false,"xploreDocumentType":"Journals & Magazine","isBook":false,"isTutorial":false,"isPromo":false,"volume":"72","issue":"10","isFreeDocument":false,"isBookWithoutChapters":false,"isDynamicHtml":true,"isSpringer":false,"isJournal":true,"isStandard":false,"isOnlineOnly":false,"isProduct":false,"isEarlyAccess":false,"isChapter":false,"htmlLink":"/document/10511075/","isCustomDenial":false,"isGiveaway":false,"htmlAbstractLink":"/document/10511075/","isSMPTE":false,"isLatestStandard":false,"isNow":false,"isTranslation":false,"isSAE":false,"isOUP":false,"isDegruyter":false,"persistentLink":"https://ieeexplore.ieee.org/servlet/opac?punumber=26","hasStandardVersions":false,"displayDocTitle":"An Optimal Two-Step Decoding for PSK-Modulated Noisy Index Coding","startPage":"6102","fundingAgencies":{"fundingAgency":[{"fundingName":"Science and Engineering Research Board (SERB) of Department of Science and Technology (DST), Government of India"},{"fundingName":"J. C. Bose National Fellowship to B. Sundar Rajan"}]},"articleCopyRight":"2024 IEEE","openAccessFlag":"F","insertDate":"30 April 2024","ephemeraFlag":"false","title":"An Optimal Two-Step Decoding for PSK-Modulated Noisy Index Coding","html_flag":"false","ml_html_flag":"true","sourcePdf":"tcomm-rajan-3395332-x.pdf","displayPublicationDate":"30 April 2024","mlTime":"PT0.0821S","xplore-pub-id":"26","pdfPath":"/iel7/26/10721242/10511075.pdf","isNumber":"10721242","rightsLinkFlag":"1","contentType":"periodicals","publicationDate":"October 2024","publicationNumber":"26","citationCount":"1","xplore-issue":"10721242","issue":"10","articleId":"10511075","publicationTitle":"IEEE Transactions on Communications","sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"volume":"72","contentTypeDisplay":"Journals","referenceCount":16,"publicationYear":"2024","subType":"IEEE Transaction","_value":"IEEE","lastupdate":"2026-09-05","mediaPath":"/mediastore/IEEE/content/media/26/10721242/10511075","endPage":"6115","displayPublicationTitle":"IEEE Transactions on Communications","doi":"10.1109/TCOMM.2024.3395332"};








