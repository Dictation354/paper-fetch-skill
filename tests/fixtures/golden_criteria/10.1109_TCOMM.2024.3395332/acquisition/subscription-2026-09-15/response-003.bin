		<meta name="Description" id="meta-description" content="This paper studies noisy index coding problems over broadcast channels. The codewords from a chosen binary index code of length N are mapped to a  $2^{N}$ -PSK ">
		
		<link rel="canonical" href="https://ieeexplore.ieee.org/document/10511075/"> 
		
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		
