dentifier\",\"visibility\":\"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN\"}}}},\"trackingParams\":\"CAMQ040EGAAiEwja9teG-e-WAxVsyBYFHZQCApM\u003d\"}},\"content\":{\"structuredDescriptionContentRenderer\":{\"items\":[{\"videoDescriptionHeaderRenderer\":{\"title\":{\"runs\":[{\"text\":\"Active Properties of Neocortical Pyramidal Neuron Dendrites: Supplemental Video 3\"}]},\"channel\":{\"runs\":[{\"text\":\"Annual Reviews Extra\"}]},\"views\":{\"runs\":[{\"text\":\"293 views\"}]},\"publishDate\":{\"runs\":[{\"text\":\"Jul 2, 2013\"}]},\"factoid\":[{\"factoidRenderer\":{\"value\":{\"runs\":[{\"text\":\"N/A\"}]},\"label\":{\"runs\":[{\"text\":\"Likes\"}]},\"accessibilityText\":\"No likes or dislikes\"}},{\"factoidRenderer\":{\"value\":{\"runs\":[{\"text\":\"293\"}]},\"label\":{\"runs\":[{\"text\":\"Views\"}]},\"accessibilityText\":\"293 views\"}},{\"factoidRenderer\":{\"value\":{\"runs\":[{\"text\":\"2013\"}]},\"label\":{\"runs\":[{\"text\":\"Jul 2\"}]},\"accessibilityText\":\"Jul 2, 2013\",\"position\":\"FACTOID_POSITION_LAST\"}}],\"channelNavigationEndpoint\":{\"clickTrackingParams\":\"CAMQ040EGAAiEwja9teG-e-WAxVsyBYFHZQCApPKAQRu8Yi-\",\"commandMetadata\":{\"webCommandMetadata\":{\"url\":\"/@annualreviewsextra\",\"webPageType\":\"WEB_PAGE_TYPE_CHANNEL\",\"rootVe\":3611,\"apiUrl\":\"/youtubei/v1/browse\"}},\"browseEndpoint\":{\"browseId\":\"UCG5VAYGeyQzOQ0CXSZOZEfw\",\"canonicalBaseUrl\":\"/@annualreviewsextra\"}},\"channelThumbnail\":{\"thumbnails\":[{\"url\":\"https://yt3.ggpht.com/ytc/AIdro_mJG11NiuGtdik1mXC16xRpMqV6H2R4b_p3ml1jUoq0iQ\u003ds88-c-k-c0x00ffffff-no-rj\"}]}}},{\"expandableVideoDescriptionBodyRenderer\":{\"descriptionBodyText\":{\"runs\":[{\"text\":\"A supplemental video from the 2013 review by Guy Major, Matthew E. Larkum, and Jackie Schiller, \\\"Active Properties of Neocortical Pyramidal Neuron Dendrites,\\\" from the Annual Review of Neuroscience: \"},{\"text\":\"http://www.annualreviews.org/doi/abs/10.1146/annurev-neuro-062111-150343?utm_source\u003dyoutube\\u0026utm_medium\u003dne.36.schiller\\u0026utm_campaign\u003dsuppvideo\"},{\"text\":\"\\n\\nThe supplemental movies show time evolution of I-V curves and membrane potential (Vm) of models, following a brief pulse of glutamate, with AMPAR conductances yielding just subthreshold and just-suprathreshold responses. Pale orange line in top panel and X in bottom right panel indicate threshold when bistable state exists. \\n\\nIn Supplemental Videos 3 and 4, the highest gmax NMDA \u003d 6 × leak. Video 3: gmax AMPA \u003d 1.37 × leak (subthreshold). Video 4: gmax AMPA \u003d 1.38 × leak (suprathreshold). Would see medium spike \u0027riding on\u0027 medium subthreshold response (if superimposed).\"}]},\"showMoreText\":{\"runs\":[{\"text\":\"...more\"}],\"accessibility\":{\"accessibilityData\":{\"label\":\"Show more\"}}},\"showLessText\":{\"runs\":[{\"text\":\"Show less\"}]}}}]}},\"veType\":124975,\"visibility\":\"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN\",\"identifier\":{\"surface\":\"ENGAGEMENT_PANEL_SURFACE_SHORTS\",\"tag\":\"video-description-ep-identifier\"},\"loggingDirectives\":{\"trackingParams\":\"CAMQ040EGAAiEwja9teG-e-WAxVsyBYFHZQCApM\u003d\"}}}],\"topbar\":{\"mobileTopbarRenderer\":{\"trackingParams\":\"CAEQwbIBIhMI2vbXhvnvlgMVbMgWBR2UAgKT\",\"topbarLogo\":{\"topbarLogoRenderer\":{\"iconImage\":{\"iconType\":\"YOUTUBE_SHORTS_OUTLINE_WITH_TEXT_24\"},\"tooltipText\":{\"runs\":[{\"text\":\"YouTube Shorts\"}]},\"endpoint\":{\"clickTrackingParams\":\"CAIQsV4iEwja9teG-e-WAxVsyBYFHZQCApPKAQRu8Yi-\",\"commandMetadata\":{\"webCommandMetadata\":{\"url\":\"https://www.youtube.com/shorts/SaW-Q_l83nI\",\"webPageType\":\"WEB_PAGE_TYPE_UNKNOWN\",\"rootVe\":83769}},\"urlEndpoint\":{\"url\":\"https://www.youtube.com/shorts/SaW-Q_l83nI\",\"target\":\"TARGET_NEW_WINDOW\"}},\"trackingParams\":\"CAIQsV4iEwja9teG-e-WAxVsyBYFHZQCApM\u003d\",\"overrideEntityKey\":\"EgZ0b3BiYXIg9QEoAQ%3D%3D\"}}}},\"frameworkUpdates\":{\"elementUpdate\":{\"updates\":[{\"templateUpdate\":{\"identifier\":\"engagem